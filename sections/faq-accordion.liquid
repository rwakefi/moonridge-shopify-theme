{% style %}
  .faq-section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }
  
  .faq-container-{{ section.id }} {
    max-width: 800px;
    margin: 0 auto;
  }

  .faq-title-{{ section.id }} {
    text-align: center;
    font-family: var(--font-heading-family);
    font-size: clamp(2.6rem, 4vw, 3.4rem);
    margin-bottom: 40px;
    color: #312110;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .faq-accordion-{{ section.id }} {
    border-bottom: 1px solid rgba(49, 33, 16, 0.12);
  }

  .faq-accordion-{{ section.id }} details {
    border-top: 1px solid rgba(49, 33, 16, 0.12);
  }

  .faq-accordion-{{ section.id }} summary {
    padding: 24px 0;
    font-size: 1.8rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #312110;
    transition: color 0.2s ease;
  }

  .faq-accordion-{{ section.id }} summary::-webkit-details-marker {
    display: none;
  }

  .faq-accordion-{{ section.id }} summary:hover {
    color: #c5a059;
  }

  .faq-accordion-{{ section.id }} summary::after {
    content: '+';
    font-size: 24px;
    font-weight: 300;
    transition: transform 0.3s ease;
  }

  .faq-accordion-{{ section.id }} details[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-content-{{ section.id }} {
    padding-bottom: 24px;
    color: rgba(49, 33, 16, 0.82);
    line-height: 1.7;
    font-size: 1.6rem;
    animation: faq-fade-in 0.3s ease-in-out;
  }

  .faq-content-{{ section.id }} p {
    margin: 0 0 0.8em;
  }

  .faq-content-{{ section.id }} p:last-child {
    margin-bottom: 0;
  }

  .faq-more-{{ section.id }} {
    border-top: 1px solid rgba(49, 33, 16, 0.12);
    margin-top: 0;
  }

  .faq-more-{{ section.id }} > summary {
    padding: 24px 0;
    font-size: 1.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #312110;
  }

  .faq-more-{{ section.id }} > summary::-webkit-details-marker {
    display: none;
  }

  .faq-more-{{ section.id }} > summary::after {
    content: '+';
    font-size: 24px;
    font-weight: 300;
    transition: transform 0.3s ease;
  }

  .faq-more-{{ section.id }}[open] > summary::after {
    transform: rotate(45deg);
  }

  .faq-more-{{ section.id }} > summary:hover {
    color: #c5a059;
  }

  .faq-more-inner-{{ section.id }} {
    padding: 0 0 8px;
  }

  .faq-more-inner-{{ section.id }} details {
    border-top: 1px solid rgba(49, 33, 16, 0.1);
  }

  .faq-more-inner-{{ section.id }} details:first-child {
    border-top: none;
  }

  .faq-footer-link-{{ section.id }} {
    text-align: center;
    margin-top: 28px;
  }

  .faq-footer-link-{{ section.id }} a {
    color: #312110;
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq-footer-link-{{ section.id }} a:hover {
    color: #c5a059;
  }

  @keyframes faq-fade-in {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 749px) {
    .faq-title-{{ section.id }} {
      font-size: 26px;
      margin-bottom: 30px;
    }
    .faq-accordion-{{ section.id }} summary,
    .faq-more-{{ section.id }} > summary {
      font-size: 16px;
      padding: 20px 0;
    }
    .faq-content-{{ section.id }} {
      font-size: 15px;
    }
  }
{% endstyle %}

{%- liquid
  assign primary_faqs = section.blocks | where: 'type', 'faq'
  assign more_count = 0
  for block in section.blocks
    if block.type == 'faq' and block.settings.place_in_more
      assign more_count = more_count | plus: 1
    endif
  endfor
  assign primary_count = section.blocks.size | minus: more_count
-%}

<div class="faq-section-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="faq-container-{{ section.id }}">
    {% if section.settings.title != blank %}
      <h2 class="faq-title-{{ section.id }}">{{ section.settings.title }}</h2>
    {% endif %}
    
    <div class="faq-accordion-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.type == 'faq' and block.settings.place_in_more == false %}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="faq-content-{{ section.id }}">
              {{ block.settings.answer }}
            </div>
          </details>
        {% endif %}
      {% endfor %}

      {% if more_count > 0 %}
        <details class="faq-more-{{ section.id }}">
          <summary>{{ section.settings.more_label | default: 'More questions' }}</summary>
          <div class="faq-more-inner-{{ section.id }}">
            {% for block in section.blocks %}
              {% if block.type == 'faq' and block.settings.place_in_more %}
                <details {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.question }}</summary>
                  <div class="faq-content-{{ section.id }}">
                    {{ block.settings.answer }}
                  </div>
                </details>
              {% endif %}
            {% endfor %}
          </div>
        </details>
      {% endif %}
    </div>

    {% if section.settings.show_faq_page_link and section.settings.faq_page_label != blank %}
      <div class="faq-footer-link-{{ section.id }}">
        <a href="{{ section.settings.faq_page_url | default: '/pages/faq' }}">{{ section.settings.faq_page_label }}</a>
      </div>
    {% endif %}
  </div>
</div>

<!-- FAQPage JSON-LD Schema for SEO/GEO -->
{% if section.blocks.size > 0 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign faq_schema_first = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq' and block.settings.question != blank -%}
        {%- unless faq_schema_first -%},{%- endunless -%}
        {%- assign faq_schema_first = false -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ block.settings.answer | strip_html | json }}
      }
    }
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{% endif %}

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "More questions expander label",
      "default": "More questions"
    },
    {
      "type": "checkbox",
      "id": "show_faq_page_link",
      "label": "Show link to full FAQ page",
      "default": true
    },
    {
      "type": "text",
      "id": "faq_page_label",
      "label": "FAQ page link label",
      "default": "View all FAQs"
    },
    {
      "type": "url",
      "id": "faq_page_url",
      "label": "FAQ page URL"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Horizontal (Mobile)",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Type your question here"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Provide the answer to the question here.</p>"
        },
        {
          "type": "checkbox",
          "id": "place_in_more",
          "label": "Place under “More questions” expander",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion (AI SEO)",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Do you shape hats bought from other stores?",
            "answer": "<p>Yes, absolutely. If you bring in a hat from somewhere else, our expert cleaning and shaping service is $35. (If you purchase a hat at Moon Ridge Co., custom shaping is always complimentary.)</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "When can I drop off a hat to be cleaned or shaped?",
            "answer": "<p>You can drop off your hat anytime during our normal business hours. Our master shaping and cleaning work takes place Thursday through Saturday, so your hat will be perfectly restored and ready during that timeframe.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do I need an appointment for hat shaping?",
            "answer": "<p>Walk-ins are always welcome! However, we highly recommend booking a 'Free Hat Experience' appointment. One-on-one time is our specialty, and booking an appointment ensures we have dedicated time to perfectly fit and shape your hat.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
