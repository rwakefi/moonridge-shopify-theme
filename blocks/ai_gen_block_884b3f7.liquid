{%- liquid
  assign ai_gen_id = block.id | replace: '_', '' | downcase
  assign carousel_collection = block.settings.collection
  assign carousel_has_products = false
  if carousel_collection != blank and carousel_collection.all_products_count > 0
    assign carousel_has_products = true
  endif
-%}

{%- unless carousel_has_products -%}
  <div {{ block.shopify_attributes }} hidden class="ai-product-carousel-empty-placeholder"></div>
{%- else -%}

{{ 'moonridge-snap-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'moonridge-snap-carousel.js' | asset_url }}" defer="defer"></script>

{% style %}

/* ------------------------------
   CAROUSEL WRAPPER + SPACING
--------------------------------*/
.ai-product-carousel-{{ ai_gen_id }} {
  /* Custom elements default to display:inline — without block, vertical padding does not create space */
  display: block;
  box-sizing: border-box;
  width: 100%;
  padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  background-color: {{ block.settings.background_color }};
}

.ai-product-carousel-container-{{ ai_gen_id }} {
  max-width: {{ block.settings.container_width }}px;
  margin: 0 auto;
  padding: 0 20px;
}

/* ------------------------------
   HEADINGS
--------------------------------*/
.ai-product-carousel-header-{{ ai_gen_id }} {
  text-align: {{ block.settings.heading_alignment }};
  margin-bottom: 16px;
}

.ai-product-carousel-heading-{{ ai_gen_id }} {
  color: {{ block.settings.heading_color }};
  margin: 0;
  font-size: {{ block.settings.heading_size }}px;
}

.ai-product-carousel-heading-{{ ai_gen_id }}:not(:only-child) {
  margin: 0 0 10px;
}

.ai-product-carousel-subheading-{{ ai_gen_id }} {
  color: {{ block.settings.text_color }};
  margin-top: -10px;
}

/* ------------------------------
   VIEW ALL
--------------------------------*/
.ai-carousel-viewall-wrap-{{ ai_gen_id }} {
  text-align: center;
  margin-top: 40px;
}

.ai-carousel-viewall-{{ ai_gen_id }} {
  display: inline-block;
  padding: 13px 30px;
  border: 1px solid {{ block.settings.button_background }};
  border-radius: {{ block.settings.card_border_radius }}px;
  color: {{ block.settings.button_background }};
  background-color: transparent;
  text-decoration: none;
  font-size: 14px;
  letter-spacing: 0.06em;
  transition: background-color 0.2s ease, color 0.2s ease;
}

.ai-carousel-viewall-{{ ai_gen_id }}:hover,
.ai-carousel-viewall-{{ ai_gen_id }}:focus {
  background-color: {{ block.settings.button_background }};
  color: {{ block.settings.button_color }};
}

/* ------------------------------
   TRACK + SLIDE AREA
--------------------------------*/
.ai-product-carousel-wrapper-{{ ai_gen_id }} {
  position: relative;
}

/* Layout + scrolling: .mr-snap__* in moonridge-snap-carousel.css */

/* ------------------------------
   PRODUCT CARD
--------------------------------*/

.ai-product-card-{{ ai_gen_id }} {
  background-color: {{ block.settings.card_background }};
  border: 1px solid {{ block.settings.card_border_color }};
  border-radius: {{ block.settings.card_border_radius }}px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  height: 100%;
}

/* IMAGE WRAPPER */
.ai-product-image-wrapper-{{ ai_gen_id }} {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  overflow: hidden;
  background-color: #f4f4f4;
}

.ai-product-image-{{ ai_gen_id }} {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  object-fit: cover;
}

.ai-product-image-placeholder-{{ ai_gen_id }} {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.3;
}

/* BADGE */
.ai-product-badge-{{ ai_gen_id }} {
  position: absolute;
  top: 10px; right: 10px;
  background-color: {{ block.settings.sale_badge_bg }};
  color: {{ block.settings.sale_badge_color }};
  padding: 5px 12px;
  border-radius: {{ block.settings.badge_border_radius }}px;
  font-size: 12px;
  font-weight: 600;
  z-index: 10;
}

/* ------------------------------
   ARROWS — shared moonridge-carousel-arrows.css
--------------------------------*/
.ai-product-carousel-stage-{{ ai_gen_id }} {
  position: relative;
}

/* TITLE + PRICE */
.ai-product-info-{{ ai_gen_id }} {
  padding: 15px;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.ai-product-title-{{ ai_gen_id }} {
  font-size: 16px;
  margin: 0 0 8px;
  color: {{ block.settings.text_color }};
}

.ai-product-title-{{ ai_gen_id }} a {
  text-decoration: none;
  color: inherit;
}

.ai-product-price-{{ ai_gen_id }} {
  display: flex;
  gap: 8px;
  font-size: 18px;
  font-weight: 600;
  color: {{ block.settings.price_color }};
}

.ai-product-price-compare-{{ ai_gen_id }} {
  color: {{ block.settings.compare_price_color }};
  text-decoration: line-through;
  font-size: 16px;
}

/* ------------------------------
   MOBILE GRID (2 x 2)
--------------------------------*/
@media screen and (max-width: 749px) {
  .ai-product-image-wrapper-{{ ai_gen_id }} {
    padding-bottom: 95% !important;
    margin-bottom: 4px !important;
  }

  .ai-product-info-{{ ai_gen_id }} {
    padding: 8px !important;
  }

  .ai-product-title-{{ ai_gen_id }} {
    margin-bottom: 4px !important;
  }

  .ai-product-price-{{ ai_gen_id }} {
    margin-top: 0 !important;
  }
}

{% endstyle %}

<product-carousel-{{ ai_gen_id }} class="ai-product-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-carousel-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-product-carousel-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-product-carousel-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <div class="ai-product-carousel-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.collection != blank and block.settings.collection.products.size > 0 %}
      <div
        class="ai-product-carousel-wrapper-{{ ai_gen_id }} moonridge-carousel-wrapper"
        data-mr-snap
        style="--mr-snap-gap: {{ block.settings.product_gap }}px; --mr-snap-per-view: {{ block.settings.products_per_view }}; --mr-snap-per-view-tablet: {{ block.settings.products_per_view_tablet }}; --mr-carousel-btn-bg: {{ block.settings.button_background | default: '#312110' }}; --mr-carousel-btn-color: {{ block.settings.button_color | default: '#ffffff' }}; --mr-carousel-btn-hover-bg: {{ block.settings.button_hover_background | default: '#1f1d24' }};"
      >
        <div class="ai-product-carousel-track-container-{{ ai_gen_id }} moonridge-carousel-stage mr-snap__viewport">
          <div class="ai-product-carousel-track-{{ ai_gen_id }} mr-snap__track" data-track>
            {%- assign shown_count = 0 -%}
            {% for product in block.settings.collection.products %}
              {%- liquid
                assign sizes_in_stock = 0
                for variant in product.variants
                  if variant.available
                    assign sizes_in_stock = sizes_in_stock | plus: 1
                  endif
                endfor
                assign effective_min_sizes = block.settings.min_sizes_in_stock
                if product.variants.size < effective_min_sizes
                  assign effective_min_sizes = product.variants.size
                endif
              -%}
              {%- if sizes_in_stock < effective_min_sizes -%}
                {%- continue -%}
              {%- endif -%}
              {%- if shown_count >= block.settings.product_limit -%}
                {%- break -%}
              {%- endif -%}
              {%- liquid
                assign page_position = shown_count | modulo: 4
                assign shown_count = shown_count | plus: 1
              -%}
              {%- if page_position == 0 -%}
                {%- if shown_count > 1 -%}</div>{%- endif -%}
                <div class="mr-snap__page">
              {%- endif -%}
              <div class="ai-product-carousel-slide-{{ ai_gen_id }} mr-snap__slide">
                <div class="ai-product-card-{{ ai_gen_id }}">
                  <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
                    {% if product.compare_at_price > product.price %}
                      <div class="ai-product-badge-{{ ai_gen_id }}">{{ block.settings.sale_badge_label }}</div>
                    {% endif %}
                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 600 }}"
                        alt="{{ product.featured_image.alt | escape }}"
                        class="ai-product-image-{{ ai_gen_id }}"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    {% else %}
                      <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                  <div class="ai-product-info-{{ ai_gen_id }}">
                    <h3 class="ai-product-title-{{ ai_gen_id }}">
                      <a href="{{ product.url }}">{{ product.title }}</a>
                    </h3>
                    <div class="ai-product-price-{{ ai_gen_id }}">
                      <span class="ai-product-price-regular-{{ ai_gen_id }}">{{ product.price | money }}</span>
                      {% if product.compare_at_price > product.price %}
                        <span class="ai-product-price-compare-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
            {%- if shown_count > 0 -%}</div>{%- endif -%}
          </div>
        </div>

        {% if block.settings.show_navigation %}
          <div class="moonridge-carousel-controls">
            <button
              type="button"
              class="ai-carousel-button-{{ ai_gen_id }} ai-carousel-prev-{{ ai_gen_id }} moonridge-carousel-btn moonridge-carousel-btn--prev"
              aria-label="Previous products"
              data-prev
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
            </button>

            <button
              type="button"
              class="ai-carousel-button-{{ ai_gen_id }} ai-carousel-next-{{ ai_gen_id }} moonridge-carousel-btn moonridge-carousel-btn--next"
              aria-label="Next products"
              data-next
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        {% endif %}
      </div>

      {%- if block.settings.show_view_all -%}
        <div class="ai-carousel-viewall-wrap-{{ ai_gen_id }}">
          <a class="ai-carousel-viewall-{{ ai_gen_id }}" href="{{ block.settings.collection.url }}">
            {{ block.settings.view_all_label }}{% if block.settings.show_view_all_count %} ({{ block.settings.collection.all_products_count }}){% endif %}
          </a>
        </div>
      {%- endif -%}
    {% else %}
      <div class="ai-carousel-empty-state-{{ ai_gen_id }}">
        <p>Next, select a collection to display products</p>
      </div>
    {% endif %}
  </div>
</product-carousel-{{ ai_gen_id }}>

{%- comment -%} Behaviour: assets/moonridge-snap-carousel.js {%- endcomment -%}

{%- endunless -%}

{% schema %}
{
  "name": "Product carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 20,
      "step": 1,
      "label": "Maximum products",
      "default": 12
    },
    {
      "type": "range",
      "id": "min_sizes_in_stock",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Minimum sizes in stock",
      "default": 3,
      "info": "Hides picked-over products. A hat with only one size left is still 'in stock' to Shopify, but a customer usually cannot buy their size. Set to 1 to show everything."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Featured products"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "header",
      "content": "View all link"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link label",
      "default": "Shop all"
    },
    {
      "type": "checkbox",
      "id": "show_view_all_count",
      "label": "Show product count in label",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_per_view",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Products per view (desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "products_per_view_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Products per view (tablet)",
      "default": 3
    },
    {
      "type": "range",
      "id": "product_gap",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Gap between products",
      "default": 20
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Container width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation",
      "default": true
    },
    {
      "type": "header",
      "content": "Sale badge"
    },
    {
      "type": "inline_richtext",
      "id": "sale_badge_label",
      "label": "Badge text",
      "default": "Sale"
    },
    {
      "type": "color",
      "id": "sale_badge_bg",
      "label": "Badge background",
      "default": "#d50000"
    },
    {
      "type": "color",
      "id": "sale_badge_color",
      "label": "Badge text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "badge_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Badge border radius",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1f1d24"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1f1d24"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price",
      "default": "#312110"
    },
    {
      "type": "color",
      "id": "compare_price_color",
      "label": "Compare at price",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#312110"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button icon",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#1f1d24"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Product carousel"
    }
  ]
}
{% endschema %}