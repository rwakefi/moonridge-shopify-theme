{%- liquid
  assign edu_blog = blog | default: article.blog
  assign hub_url = '/pages/shop-hats'
  if pages['shop-hats'] != blank
    assign hub_url = pages['shop-hats'].url
  endif
  assign hat_finder_url = 'https://hatfinder.moonridgecompany.com'
  assign hat_finder_app_store_url = 'https://apps.apple.com/us/app/hat-finder/id6767718895?itscg=30200&itsct=apps_box_link&mttnsubad=6767718895'

-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "description": {{ article.excerpt | default: article.content | strip_html | truncate: 160 | json }},
  "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%d' | json }},
  "author": {
    "@type": "Person",
    "name": {{ article.author | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | json }}
  },
  "mainEntityOfPage": {{ request.origin | append: article.url | json }},
  "url": {{ request.origin | append: article.url | json }}
  {%- if article.image -%}
  ,"image": {{ article.image | image_url: width: 1200 | prepend: "https:" | json }}
  {%- endif -%}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ request.origin | json }}
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Hat Education",
      "item": {{ request.origin | append: edu_blog.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ article.title | json }},
      "item": {{ request.origin | append: article.url | json }}
    }
  ]
}
</script>

<section class="he-article">
  <div class="he-article__inner page-width">

    <nav class="he-article__crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <a href="{{ edu_blog.url }}">Hat Education</a>
    </nav>

    <header class="he-article__hero">
      <a class="he-article__mark" href="{{ routes.root_url }}">
        <img
          class="he-article__mark-img"
          src="{{ 'moon-ridge-m-mark.png' | asset_url }}"
          width="256"
          height="256"
          alt="Moon Ridge"
        >
      </a>
      <p class="he-article__eyebrow">Hat Education</p>
      <h1 class="he-article__title">{{ article.title | escape }}</h1>
      {%- if article.excerpt != blank -%}
        <p class="he-article__deck">{{ article.excerpt | strip_html }}</p>
      {%- endif -%}
    </header>

    {%- if article.image -%}
      <figure class="he-article__figure he-article__figure--featured">
        <img
          src="{{ article.image | image_url: width: 2000 }}"
          srcset="{{ article.image | image_url: width: 800 }} 800w, {{ article.image | image_url: width: 1400 }} 1400w, {{ article.image | image_url: width: 2000 }} 2000w"
          sizes="(min-width: 990px) min(880px, 100vw), 100vw"
          alt="{{ article.image.alt | default: article.title | escape }}"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
          loading="eager"
          fetchpriority="high"
        >
      </figure>
    {%- endif -%}

    {% render 'hat-education-shop-cta' %}

    <div class="he-article__body rte">
      {{ article.content }}
    </div>
  </div>

  <script src="{{ 'hat-education-article.js' | asset_url }}" defer="defer"></script>

  {% render 'hat-education-shop', unique_id: 'hat-ed-article' %}

  <div class="he-article__inner he-article__inner--after page-width">
    <aside class="he-article__cta" aria-label="Next steps">
      <div class="he-article__cta-inner">
        <div class="he-article__cta-copy">
          <p class="he-article__cta-label">Ready to find your fit?</p>
          <p class="he-article__cta-text">Try <a href="{{ hat_finder_url }}">Hat Finder</a> on the web or iPhone, book a free fitting in Fayetteville, or browse hats with expert guidance built in.</p>
        </div>
        <div class="he-article__cta-actions">
          <a class="he-article__btn he-article__btn--primary" href="{{ hat_finder_url }}">Try Hat Finder</a>
          <a class="he-article__btn he-article__btn--secondary" href="{{ hat_finder_app_store_url }}" target="_blank" rel="noopener noreferrer">Get the iPhone app</a>
          <a class="he-article__btn he-article__btn--secondary" href="https://moonridgecompany.setmore.com">Book a fitting</a>
          <a class="he-article__btn he-article__btn--secondary" href="{{ hub_url }}">Shop hats</a>
        </div>
      </div>
    </aside>

    {%- assign related_count = 0 -%}
    {%- for related in edu_blog.articles limit: 12 -%}
      {%- unless related.id == article.id -%}
        {%- assign related_count = related_count | plus: 1 -%}
      {%- endunless -%}
    {%- endfor -%}

    {%- if related_count > 0 -%}
      <aside class="he-article__related">
        <h2 class="he-article__related-heading">More guides</h2>
        <ul class="he-article__related-grid" role="list">
          {%- assign shown = 0 -%}
          {%- for related in edu_blog.articles -%}
            {%- unless related.id == article.id -%}
              {%- if shown < 3 -%}
                <li>
                  <a class="he-article__related-card" href="{{ related.url }}">
                    <span class="he-article__related-title">{{ related.title | escape }}</span>
                  </a>
                </li>
                {%- assign shown = shown | plus: 1 -%}
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        </ul>
        <p class="he-article__related-all">
          <a href="{{ edu_blog.url }}">View all Hat Education guides →</a>
        </p>
      </aside>
    {%- endif -%}

    {%- if article.previous or article.next -%}
      <nav class="he-article__nav" aria-label="Guide navigation">
        {%- if article.previous -%}
          <a href="{{ article.previous.url }}" class="he-article__nav-link he-article__nav-link--prev">
            <span class="he-article__nav-kicker">Previous</span>
            <span class="he-article__nav-title">{{ article.previous.title | escape }}</span>
          </a>
        {%- else -%}
          <span class="he-article__nav-spacer"></span>
        {%- endif -%}
        {%- if article.next -%}
          <a href="{{ article.next.url }}" class="he-article__nav-link he-article__nav-link--next">
            <span class="he-article__nav-kicker">Next guide</span>
            <span class="he-article__nav-title">{{ article.next.title | escape }}</span>
          </a>
        {%- endif -%}
      </nav>
    {%- endif -%}

  </div>
</section>

<style>
  .he-article {
    --he-ink: #312110;
    --he-accent: #c5a059;
    --he-cream: #f6f2ec;
    background: transparent;
  }

  /* Wide editorial column on desktop (photo + title), readable text
     column underneath. Mobile keeps the same side padding as today. */
  .he-article__inner {
    max-width: 120rem;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 2rem;
  }

  @media screen and (min-width: 990px) {
    .he-article__inner {
      padding-left: 5rem;
      padding-right: 5rem;
    }
  }

  .he-article__inner--after {
    padding-top: 2.25rem;
    padding-bottom: 4rem;
  }

  .he-article__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    margin: 0 0 2.8rem;
    font-size: 1.2rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: rgba(49, 33, 16, 0.65);
  }

  .he-article__crumbs a {
    color: var(--he-ink);
    text-decoration: none;
  }

  .he-article__crumbs a:hover {
    color: var(--he-accent);
  }

  .he-article__hero {
    text-align: center;
    margin-bottom: 2rem;
  }

  .he-article__mark {
    display: block;
    width: 3.4rem;
    margin: 0 auto 1.15rem;
    line-height: 0;
  }

  .he-article__mark-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .he-article__eyebrow {
    margin: 0 0 1.4rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--he-accent);
    font-family: var(--font-heading-family);
  }

  .he-article__title {
    margin: 0 0 1rem;
    font-family: var(--font-heading-family);
    font-size: clamp(3.4rem, 5vw, 4.4rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.15;
    color: var(--he-ink);
  }

  .he-article__deck {
    margin: 0 auto;
    max-width: 62rem;
    font-size: 2.1rem;
    line-height: 1.55;
    color: rgba(49, 33, 16, 0.82);
  }

  .he-article__figure {
    margin: 0 0 2.5rem;
    border-radius: 0;
    overflow: hidden;
    background: var(--he-cream);
    border: 1px solid #000;
  }

  @media screen and (min-width: 990px) {
    .he-article__figure--featured {
      max-width: 80%;
      margin-left: auto;
      margin-right: auto;
    }
  }

  .he-article__figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }

  .he-article__figure--product {
    background: #fff;
    border: 1px solid rgba(49, 33, 16, 0.08);
    overflow: hidden;
  }

  .he-article__figure--product a {
    display: block;
    text-decoration: none;
  }

  .he-article__figure--product figcaption {
    margin: 0;
    padding: 0.85rem 1rem 1rem;
    background: var(--he-cream);
    font-family: var(--font-heading-family);
    font-size: 1.4rem;
    line-height: 1.45;
    letter-spacing: 0.02em;
    color: rgba(49, 33, 16, 0.78);
    text-align: center;
  }

  .he-article__figure--product figcaption a {
    display: inline;
    color: var(--he-ink);
    text-decoration: underline;
    text-decoration-color: rgba(49, 33, 16, 0.28);
    text-underline-offset: 0.18em;
  }

  .he-article__figure--inline {
    margin: 0.5rem 0 2rem;
  }

  .he-article__body .he-article__figure--product img {
    margin: 0;
    border-radius: 0;
  }

  /* Article body — tuned for pasted guides (p + strong headings, hr breaks) */
  .he-article__body {
    font-size: 1.9rem;
    line-height: 1.68;
    color: #2b241e;
    letter-spacing: 0;
    max-width: 69rem; /* ~72 characters at 19px */
    margin-left: auto;
    margin-right: auto;
  }

  .he-article__body.rte p,
  .he-article__body.rte li {
    font-size: 1.9rem !important;
    line-height: 1.68 !important;
  }

  .he-article__body.rte [style*="font-size"] {
    font-size: inherit !important;
  }

  @media screen and (min-width: 750px) {
    .he-article__body {
      font-size: 1.9rem;
    }

    .he-article__body.rte p,
    .he-article__body.rte li {
      font-size: 1.9rem !important;
    }
  }

  @media screen and (max-width: 749px) {
    .he-article__body,
    .he-article__body.rte p,
    .he-article__body.rte li {
      font-size: 1.8rem !important;
      line-height: 1.65 !important;
    }
  }

  /* Ignore stray classes from AI / external editors (keep our he-* layout classes) */
  .he-article__body [class]:not([class^="he-article__"]):not([class^="he-face-"]) {
    font-family: inherit !important;
    line-height: inherit !important;
    letter-spacing: inherit !important;
    text-transform: none !important;
    white-space: normal !important;
    word-break: normal !important;
    color: inherit !important;
  }

  .he-article__body p {
    margin: 0 0 2.4rem;
  }

  /* Hide duplicate title when first line is bold-only (page already has h1) */
  .he-article__body > p:first-child:has(> strong:only-child):not(.he-article__byline) {
    display: none;
  }

  .he-article__body .he-article__byline {
    margin: 0 0 1.15rem;
    font-family: var(--font-heading-family);
    font-size: 1.2rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--he-accent);
  }

  .he-article__body .he-article__byline strong {
    font-weight: 500;
    color: inherit;
  }

  /* Intro: paragraphs before the first divider */
  .he-article__body > hr:first-of-type {
    margin-top: 0.5rem;
  }

  .he-article__body > p:first-of-type:not(:has(> strong:only-child)):not(.he-article__byline):not(.he-article__see-also),
  .he-article__body > p:first-child:has(> strong:only-child):not(.he-article__byline) + p:not(.he-article__see-also),
  .he-article__body .he-article__lede {
    font-size: 2.2rem;
    line-height: 1.55;
    color: rgba(43, 36, 30, 0.95);
  }

  @media screen and (min-width: 750px) {
    .he-article__body > p:first-of-type:not(:has(> strong:only-child)):not(.he-article__byline):not(.he-article__see-also),
    .he-article__body > p:first-child:has(> strong:only-child):not(.he-article__byline) + p:not(.he-article__see-also),
    .he-article__body .he-article__lede {
      font-size: 2.2rem;
    }
  }

  @media screen and (max-width: 749px) {
    .he-article__body > p:first-of-type:not(:has(> strong:only-child)):not(.he-article__byline):not(.he-article__see-also),
    .he-article__body > p:first-child:has(> strong:only-child):not(.he-article__byline) + p:not(.he-article__see-also),
    .he-article__body .he-article__lede {
      font-size: 2.05rem !important;
      line-height: 1.55 !important;
    }
  }

  /* Section breaks */
  .he-article__body hr {
    border: 0;
    height: 1px;
    margin: 4.4rem 0;
    background: linear-gradient(
      to right,
      transparent,
      rgba(49, 33, 16, 0.18) 15%,
      rgba(49, 33, 16, 0.18) 85%,
      transparent
    );
  }

  /* Bold-only paragraph = section heading (e.g. "Oval Heads") */
  .he-article__body p:has(> strong:only-child) {
    margin-top: 2rem;
    margin-bottom: 0.65rem;
    max-width: none;
  }

  .he-article__body p:has(> strong:only-child) strong {
    display: block;
    font-family: var(--font-heading-family);
    font-size: 1.55rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.35;
    color: var(--he-ink);
    text-transform: none;
  }

  @media screen and (min-width: 750px) {
    .he-article__body p:has(> strong:only-child) strong {
      font-size: 1.65rem;
    }
  }

  /* Bold inside body copy */
  .he-article__body p:not(:has(> strong:only-child)) strong {
    font-weight: 600;
    color: var(--he-ink);
  }

  .he-article__body h2,
  .he-article__body.rte h2 {
    margin: 5.2rem 0 1.4rem;
    font-family: var(--font-heading-family);
    font-size: 2.6rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.22;
    text-transform: none;
    color: var(--he-ink);
  }

  @media screen and (min-width: 750px) {
    .he-article__body h2,
    .he-article__body.rte h2 {
      font-size: 2.9rem;
    }
  }

  .he-article__body hr + h2,
  .he-article__body.rte hr + h2 {
    margin-top: 4.4rem;
  }

  .he-article__body .he-article__see-also {
    margin-bottom: 3.4rem;
    padding: 1.6rem 2rem;
    background: var(--he-cream);
    border-left: 3px solid var(--he-accent);
    border-radius: 6px;
    font-size: 1.55rem;
    line-height: 1.65;
  }

  /* Face shape guide blocks */
  .he-article__body .he-face-shape {
    margin: 0 0 0.5rem;
  }

  .he-article__body .he-face-shape__desc {
    margin: 0 0 1rem;
  }

  .he-article__body .he-face-shape__styles {
    margin: 0 0 0.25rem;
  }

  .he-article__body .he-face-shape__styles strong {
    display: block;
    margin-bottom: 0.4rem;
    font-family: var(--font-heading-family);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--he-accent);
  }

  .he-article__body .he-article__closing {
    margin-top: 0.5rem;
  }

  .he-article__body .he-article__closing h2 {
    margin-top: 0;
  }

  .he-article__body .he-article__see-also a {
    font-weight: 600;
  }

  .he-article__body .he-article__rules {
    margin: 0 0 2.25rem;
    padding: 1.5rem 1.6rem 1.15rem;
    background: var(--he-cream);
    border: 1px solid rgba(49, 33, 16, 0.08);
    border-radius: 8px;
  }

  .he-article__body .he-article__rules h2 {
    margin: 0 0 0.85rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--he-accent);
  }

  .he-article__body .he-article__rules p {
    margin: 0;
    padding: 0.7rem 0;
    border-top: 1px solid rgba(49, 33, 16, 0.1);
    font-size: 1.75rem !important;
    line-height: 1.45 !important;
  }

  .he-article__body .he-article__rules p strong {
    font-family: var(--font-heading-family);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--he-ink);
  }

  .he-article__body .he-article__facts {
    display: grid;
    gap: 0.85rem;
    margin: 0 0 1.75rem;
  }

  @media screen and (min-width: 750px) {
    .he-article__body .he-article__facts {
      grid-template-columns: 1fr 1fr;
    }
  }

  .he-article__body .he-article__facts p {
    margin: 0;
    padding: 1rem 1.05rem 1.05rem;
    background: #fff;
    border: 1px solid rgba(49, 33, 16, 0.1);
    border-radius: 6px;
    font-size: 1.7rem !important;
    line-height: 1.5 !important;
  }

  .he-article__body .he-article__facts p strong {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-heading-family);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--he-accent);
  }

  .he-article__body hr:has(+ .he-article__rules),
  .he-article__rules + hr {
    display: none;
  }

  .he-article__body h3,
  .he-article__body.rte h3 {
    margin: 3.6rem 0 1rem;
    font-family: var(--font-heading-family);
    font-size: 2.1rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: none;
    color: var(--he-ink);
  }

  .he-article__body h4 {
    margin: 1.5rem 0 0.5rem;
    font-weight: 600;
    color: var(--he-ink);
  }

  .he-article__body ul,
  .he-article__body ol {
    margin: 0 0 1.25rem;
    padding-left: 1.35rem;
  }

  .he-article__body li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .he-article__body blockquote {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--he-accent);
    background: var(--he-cream);
    font-style: italic;
    color: rgba(49, 33, 16, 0.9);
  }

  .he-article__body img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 1.5rem 0;
  }

  .he-article__body a {
    color: var(--he-ink);
    text-decoration: underline;
    text-decoration-color: rgba(49, 33, 16, 0.35);
    text-underline-offset: 0.2em;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .he-article__body a:hover {
    color: var(--he-accent);
    text-decoration-color: var(--he-accent);
  }

  .he-article__cta {
    margin: 0 0 2.5rem;
    padding: 2rem;
    background: linear-gradient(135deg, rgba(197, 160, 89, 0.12), rgba(49, 33, 16, 0.06));
    border: 1px solid rgba(49, 33, 16, 0.1);
    border-radius: 8px;
  }

  .he-article__cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .he-article__cta-label {
    margin: 0 0 0.35rem;
    font-size: 1.2rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--he-accent);
    font-family: var(--font-heading-family);
  }

  .he-article__cta-text {
    margin: 0;
    font-size: 1.7rem;
    color: var(--he-ink);
  }

  .he-article__cta-text a {
    color: var(--he-ink);
    text-decoration: underline;
    text-decoration-color: var(--he-accent);
    text-underline-offset: 0.15em;
  }

  .he-article__cta-text a:hover {
    color: var(--he-accent);
  }

  .he-article__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .he-article__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.35rem;
    border-radius: 4px;
    font-size: 1.25rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    font-family: var(--font-heading-family);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .he-article__btn--primary {
    background: var(--he-ink);
    color: #fff;
  }

  .he-article__btn--primary:hover {
    background: #4a3428;
  }

  .he-article__btn--secondary {
    background: transparent;
    color: var(--he-ink);
    border: 1px solid rgba(49, 33, 16, 0.35);
  }

  .he-article__btn--secondary:hover {
    border-color: var(--he-accent);
    color: var(--he-accent);
  }

  .he-article__related {
    margin-bottom: 2.5rem;
