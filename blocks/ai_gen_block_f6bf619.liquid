{% doc %}
  @prompt
    a section the same size as the lumen slideshow section below, this will just be a single picture, it needs to be 1920 by 1080, add a mobile image that is 1080 by 1350
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-single-image-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .ai-single-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    position: relative;
  }

  .ai-single-image-desktop-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-single-image-mobile-{{ ai_gen_id }} {
    display: none;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: cover;
  }

  .ai-single-image-photo-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 1920 / 1080;
  }

  .ai-single-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-single-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-single-image-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-single-image-cta-{{ ai_gen_id }} {
    --mr-cta-band: {{ block.settings.cta_background | default: '#ffffff' }};
    --mr-cta-ink: {{ block.settings.cta_text_color | default: '#312110' }};
    --mr-cta-rule: {{ block.settings.cta_accent_color | default: '#c4b49a' }};
    --mr-btn-bg: {{ block.settings.button_background | default: '#312110' }};
    --mr-btn-text: {{ block.settings.button_text_color | default: '#ffffff' }};

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 20px 18px;
    background: var(--mr-cta-band);
    border-top: 1px solid color-mix(in srgb, var(--mr-cta-rule) 70%, transparent);
    text-align: center;
  }

  .ai-single-image-cta--photo-{{ ai_gen_id }} {
    background-image:
      linear-gradient(color-mix(in srgb, var(--mr-cta-band) 66%, transparent), color-mix(in srgb, var(--mr-cta-band) 66%, transparent)),
      var(--mr-cta-photo);
    background-size: cover;
    background-position: center 62%;
    padding-top: 26px;
    padding-bottom: 28px;
  }
  .ai-single-image-cta--photo-{{ ai_gen_id }} .ai-single-image-cta-copy-{{ ai_gen_id }} {
    opacity: 1;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.65);
  }
  .ai-single-image-cta--music-{{ ai_gen_id }} {
    position: relative;
    padding-left: 150px;
    padding-right: 150px;
  }
  .ai-single-image-cta-art-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--mr-cta-rule);
    pointer-events: none;
    transform: translateY(-50%);
  }
  .ai-single-image-cta-art--left-{{ ai_gen_id }} {
    left: max(28px, calc(50% - 600px));
  }
  .ai-single-image-cta-art--right-{{ ai_gen_id }} {
    right: max(28px, calc(50% - 600px));
    flex-direction: row-reverse;
  }
  .ai-single-image-cta-guitar-{{ ai_gen_id }} {
    display: block;
    width: auto;
    height: 78px;
    transform: rotate(-24deg);
  }
  .ai-single-image-cta-art--right-{{ ai_gen_id }} .ai-single-image-cta-guitar-{{ ai_gen_id }} {
    transform: scaleX(-1) rotate(-24deg);
  }
  .ai-single-image-cta-notes-{{ ai_gen_id }} {
    display: block;
    width: auto;
    height: 34px;
    opacity: 0.85;
  }
  .ai-single-image-cta-eyebrow-{{ ai_gen_id }} {
    margin: 0 0 -4px;
    color: var(--mr-cta-rule);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .ai-single-image-cta--photo-{{ ai_gen_id }} .ai-single-image-cta-eyebrow-{{ ai_gen_id }} {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.65);
  }
  .ai-single-image-cta-copy-{{ ai_gen_id }} {
    margin: 0;
    color: var(--mr-cta-ink);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.4;
    opacity: 0.78;
  }

  .ai-single-image-cta-actions-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
  }

  .ai-single-image-cta-btn-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 11px 22px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .ai-single-image-cta-btn-{{ ai_gen_id }} svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .ai-single-image-cta-btn--primary-{{ ai_gen_id }} {
    color: var(--mr-btn-text);
    background-color: var(--mr-btn-bg);
    border: 1px solid var(--mr-btn-bg);
  }

  .ai-single-image-cta-btn--primary-{{ ai_gen_id }}:hover {
    transform: translateY(-1px);
  }

  .ai-single-image-cta-btn--primary-{{ ai_gen_id }}:hover svg {
    transform: translateX(2px);
  }

  .ai-single-image-cta-btn--secondary-{{ ai_gen_id }} {
    color: var(--mr-cta-ink);
    background-color: transparent;
    border: 1px solid color-mix(in srgb, var(--mr-cta-ink) 55%, transparent);
  }

  .ai-single-image-cta-btn--secondary-{{ ai_gen_id }}:hover {
    background-color: color-mix(in srgb, var(--mr-cta-ink) 6%, transparent);
    border-color: var(--mr-cta-ink);
  }

  .ai-single-image-cta-appstore-{{ ai_gen_id }} {
    display: none;
    line-height: 0;
    text-decoration: none;
    opacity: 0.95;
  }

  .ai-single-image-cta-appstore-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-single-image-cta-appstore-badge-{{ ai_gen_id }} {
    display: block;
    width: 140px;
    max-width: 100%;
    height: auto;
  }

  .ai-single-image-cta-btn-{{ ai_gen_id }}:focus-visible,
  .ai-single-image-cta-appstore-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid var(--mr-btn-bg);
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-single-image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-single-image-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-single-image-placeholder-{{ ai_gen_id }} {
      aspect-ratio: 1080 / 1350;
    }

    .ai-single-image-photo-{{ ai_gen_id }} {
      aspect-ratio: 1080 / 1350;
    }

    .ai-single-image-cta-{{ ai_gen_id }} {
      gap: 10px;
      padding: 14px 16px 16px;
    }

    .ai-single-image-cta--music-{{ ai_gen_id }} {
      padding-left: 58px;
      padding-right: 58px;
    }
    .ai-single-image-cta-art-{{ ai_gen_id }} {
      top: 14px;
      transform: none;
    }
    .ai-single-image-cta-art--left-{{ ai_gen_id }} {
      left: 8px;
    }
    .ai-single-image-cta-art--right-{{ ai_gen_id }} {
      right: 8px;
    }
    .ai-single-image-cta-guitar-{{ ai_gen_id }} {
      height: 50px;
    }
    .ai-single-image-cta-notes-{{ ai_gen_id }} {
      display: none;
    }
    .ai-single-image-cta-actions-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 8px;
    }

    .ai-single-image-cta-btn-{{ ai_gen_id }} {
      width: 100%;
      max-width: 360px;
    }

    .ai-single-image-cta--has-appstore-{{ ai_gen_id }} .ai-single-image-cta-btn--secondary-{{ ai_gen_id }} {
      display: none;
    }

    .ai-single-image-cta-appstore-{{ ai_gen_id }} {
      display: inline-flex;
    }

    .ai-single-image-cta-appstore-badge-{{ ai_gen_id }} {
      width: 160px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-single-image-cta-btn-{{ ai_gen_id }},
    .ai-single-image-cta-btn-{{ ai_gen_id }} svg {
      transition: none;
    }

    .ai-single-image-cta-btn--primary-{{ ai_gen_id }}:hover {
      transform: none;
    }

    .ai-single-image-cta-btn--primary-{{ ai_gen_id }}:hover svg {
      transform: none;
    }
  }
{% endstyle %}

<div class="ai-single-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-single-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.desktop_image and block.settings.mobile_image %}
      <picture>
        <source
          media="(min-width: 750px)"
          srcset="{{ block.settings.desktop_image | image_url: width: 960 }} 960w, {{ block.settings.desktop_image | image_url: width: 1440 }} 1440w, {{ block.settings.desktop_image | image_url: width: 1920 }} 1920w"
          sizes="100vw"
          width="1920"
          height="1080"
        >
        <img
          src="{{ block.settings.mobile_image | image_url: width: 750 }}"
          srcset="{{ block.settings.mobile_image | image_url: width: 750 }} 750w, {{ block.settings.mobile_image | image_url: width: 1080 }} 1080w"
          sizes="100vw"
          alt="{{ block.settings.mobile_image.alt | default: block.settings.desktop_image.alt | escape }}"
          loading="eager"
          fetchpriority="high"
          width="1080"
          height="1350"
          class="ai-single-image-photo-{{ ai_gen_id }}"
        >
      </picture>
    {% elsif block.settings.desktop_image %}
      <img
        src="{{ block.settings.desktop_image | image_url: width: 1920 }}"
        srcset="{{ block.settings.desktop_image | image_url: width: 960 }} 960w, {{ block.settings.desktop_image | image_url: width: 1920 }} 1920w"
        sizes="100vw"
        alt="{{ block.settings.desktop_image.alt | escape }}"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="1080"
        class="ai-single-image-desktop-{{ ai_gen_id }}"
      >
    {% elsif block.settings.mobile_image %}
      <img
        src="{{ block.settings.mobile_image | image_url: width: 1080 }}"
        alt="{{ block.settings.mobile_image.alt | escape }}"
        loading="eager"
        fetchpriority="high"
        width="1080"
        height="1350"
        class="ai-single-image-mobile-{{ ai_gen_id }}"
        style="display: block;"
      >
    {% else %}
      <div class="ai-single-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-single-image-empty-state-{{ ai_gen_id }}">
          Add a desktop image (1920 x 1080)
        </div>
      </div>
    {% endif %}
  </div>

  {%- if block.settings.button_label != blank or block.settings.secondary_label != blank or block.settings.app_store_link != blank -%}
    <div class="ai-single-image-cta-{{ ai_gen_id }}{% if block.settings.app_store_link != blank %} ai-single-image-cta--has-appstore-{{ ai_gen_id }}{% endif %}{% if block.settings.cta_music_art %} ai-single-image-cta--music-{{ ai_gen_id }}{% endif %}{% if block.settings.cta_background_image %} ai-single-image-cta--photo-{{ ai_gen_id }}{% endif %}"{% if block.settings.cta_background_image %} style="--mr-cta-photo: url('{{ block.settings.cta_background_image | image_url: width: 2400 }}');"{% endif %}>
      {%- if block.settings.cta_music_art -%}
        {%- capture mr_guitar -%}
          <svg class="ai-single-image-cta-guitar-{{ ai_gen_id }}" viewBox="0 0 40 104" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <rect x="15.5" y="2" width="9" height="12" rx="2" fill="currentColor"/>
            <circle cx="13.6" cy="5.5" r="1.7" fill="currentColor"/><circle cx="13.6" cy="10.5" r="1.7" fill="currentColor"/>
            <circle cx="26.4" cy="5.5" r="1.7" fill="currentColor"/><circle cx="26.4" cy="10.5" r="1.7" fill="currentColor"/>
            <rect x="17.6" y="12" width="4.8" height="40" fill="currentColor"/>
            <circle cx="20" cy="56" r="12.5" fill="currentColor"/>
            <circle cx="20" cy="81" r="17" fill="currentColor"/>
            <circle cx="20" cy="64" r="5" fill="var(--mr-cta-band)"/>
            <rect x="14" y="83" width="12" height="3" rx="1" fill="var(--mr-cta-band)"/>
            <path d="M18.8 4v80M20 4v80M21.2 4v80" stroke="var(--mr-cta-band)" stroke-width=".45" opacity=".75"/>
          </svg>
        {%- endcapture -%}
        {%- capture mr_notes -%}
          <svg class="ai-single-image-cta-notes-{{ ai_gen_id }}" viewBox="0 0 30 34" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <ellipse cx="6.5" cy="27" rx="4.6" ry="3.4" transform="rotate(-20 6.5 27)" fill="currentColor"/>
            <ellipse cx="22.5" cy="23" rx="4.6" ry="3.4" transform="rotate(-20 22.5 23)" fill="currentColor"/>
            <path d="M10.6 26V6l16-4v20" fill="none" stroke="currentColor" stroke-width="1.8"/>
            <path d="M10.6 6l16-4v4l-16 4z" fill="currentColor"/>
          </svg>
        {%- endcapture -%}
        <span class="ai-single-image-cta-art-{{ ai_gen_id }} ai-single-image-cta-art--left-{{ ai_gen_id }}">{{ mr_guitar }}{{ mr_notes }}</span>
        <span class="ai-single-image-cta-art-{{ ai_gen_id }} ai-single-image-cta-art--right-{{ ai_gen_id }}">{{ mr_guitar }}{{ mr_notes }}</span>
      {%- endif -%}
      {%- if block.settings.cta_eyebrow != blank -%}
        <p class="ai-single-image-cta-eyebrow-{{ ai_gen_id }}">{{ block.settings.cta_eyebrow | escape }}</p>
      {%- endif -%}
      {%- if block.settings.cta_support != blank -%}
        <p class="ai-single-image-cta-copy-{{ ai_gen_id }}">{{ block.settings.cta_support | escape }}</p>
      {%- endif -%}

      <div class="ai-single-image-cta-actions-{{ ai_gen_id }}">
        {%- if block.settings.button_label != blank -%}
          <a
            href="{{ block.settings.button_link | default: '/pages/shop-hats' }}"
            class="ai-single-image-cta-btn-{{ ai_gen_id }} ai-single-image-cta-btn--primary-{{ ai_gen_id }}"
          >
            <span>{{ block.settings.button_label | escape }}</span>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if block.settings.secondary_label != blank -%}
          <a
            href="{{ block.settings.secondary_link | default: 'https://hatfinder.moonridgecompany.com' }}"
            class="ai-single-image-cta-btn-{{ ai_gen_id }} ai-single-image-cta-btn--secondary-{{ ai_gen_id }}"
          >
            <span>{{ block.settings.secondary_label | escape }}</span>
          </a>
        {%- endif -%}

        {%- if block.settings.app_store_link != blank -%}
          <a
            href="{{ block.settings.app_store_link }}"
            class="ai-single-image-cta-appstore-{{ ai_gen_id }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ block.settings.app_store_label | default: 'Download Hat Finder on the App Store' | escape }}"
          >
            <img
              class="ai-single-image-cta-appstore-badge-{{ ai_gen_id }}"
              src="{{ 'download-on-the-app-store.svg' | asset_url }}"
              alt="Download on the App Store"
              width="140"
              height="47"
              loading="lazy"
            >
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Single image",
  "settings": [
    {
      "type": "header",
      "content": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image",
      "info": "Recommended size: 1920 x 1080 pixels"
    },
    {
      "type": "header",
      "content": "Mobile image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Recommended size: 1080 x 1350 pixels. If not set, desktop image will be used."
    },
    {
      "type": "header",
      "content": "Shop CTA"
    },
    {
      "type": "text",
      "id": "cta_eyebrow",
      "label": "Top line",
      "info": "Optional small line above the supporting line, in the top rule color."
    },
    {
      "type": "text",
      "id": "cta_support",
      "label": "Supporting line",
      "default": "Want an Interactive Experience"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "info": "Leave blank to hide the primary button."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Try Hat Finder",
      "info": "Shown on desktop. Hidden on mobile when an App Store link is set."
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link",
      "info": "Defaults to https://hatfinder.moonridgecompany.com if blank."
    },
    {
      "type": "text",
      "id": "app_store_label",
      "label": "App Store badge accessibility label",
      "default": "Download Hat Finder on the App Store",
      "info": "Used for screen readers. The badge replaces Try Hat Finder on mobile only."
    },
    {
      "type": "url",
      "id": "app_store_link",
      "label": "App Store link (mobile only)",
      "info": "Shows the official App Store badge on mobile in place of Try Hat Finder. Hidden on desktop."
    },
    {
      "type": "image_picker",
      "id": "cta_background_image",
      "label": "CTA band background photo",
      "info": "Optional. Shown behind the band under a tint of the band background color. Wide images work best (about 2400 x 500)."
    },
    {
      "type": "checkbox",
      "id": "cta_music_art",
      "label": "Show guitar and music-note art on the sides",
      "info": "For music events. Brass line art in the top rule color.",
      "default": false
    },
    {
      "type": "color",
      "id": "cta_background",
      "label": "CTA band background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Supporting text color",
      "default": "#312110"
    },
    {
      "type": "color",
      "id": "cta_accent_color",
      "label": "Top rule color",
      "default": "#c4b49a"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Primary button background",
      "default": "#312110"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Primary button text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Single image"
    }
  ],
  "tag": null
}
{% endschema %}
