{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign brand_intro_wide = false
  if template.suffix == 'brand' or template.suffix == 'brand-v2' or template.suffix == 'brand-nav'
    assign brand_intro_wide = true
  endif
  if page.handle == 'stetson' or page.handle == 'resistol' or page.handle == 'lucchese' or page.handle == 'pendleton' or page.handle == 'goorin-bros' or page.handle == 'bigalli-1'
    assign brand_intro_wide = true
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Just scale the title down – keep theme font & styling */
  .main-page-title {
    font-size: clamp(1.5rem, 1.7vw + 0.5rem, 3.0rem) !important;
    text-align: center;
    margin-bottom: 2rem;
  }

  {%- if brand_intro_wide -%}
  #shopify-section-{{ section.id }} .page-width {
    max-width: 1000px !important;
  }

  #shopify-section-{{ section.id }} .rte {
    max-width: min(68rem, 92vw) !important;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    font-size: 1.7rem;
    line-height: 1.7;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .rte {
      max-width: 92vw;
      font-size: 1.55rem;
      line-height: 1.65;
    }
  }
  {%- endif -%}
{%- endstyle -%}

<div class="page-width{% unless brand_intro_wide %} page-width--narrow{% endunless %} section-{{ section.id }}-padding">
  <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ page.title | escape }}
  </h1>
  <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {{ page.content }}
  </div>
</div>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": {{ page.title | json }},
    "description": {{ page.description | default: page.content | strip_html | truncate: 160 | json }},
    "url": {{ request.origin | append: page.url | json }},
    "mainEntity": {
      "@type": "{% if page.handle contains 'about' or page.handle contains 'heritage' %}Organization{% else %}WebPage{% endif %}",
      "name": {{ page.title | json }}
    }
  }
</script>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}