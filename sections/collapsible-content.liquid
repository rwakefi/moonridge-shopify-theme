{%- liquid
  assign intro = section.settings.intro
-%}

<section class="rm-faq section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="rm-faq-inner page-width" style="max-width: {{ section.settings.content_max_width }}px;">
    {% if section.settings.heading != blank %}
      <h2 class="rm-faq-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if intro != blank %}
      <div class="rm-faq-intro rte">{{ intro }}</div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="rm-faq-items">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'category' -%}
              {% if block.settings.title != blank %}
                <h3 class="rm-faq-category" {{ block.shopify_attributes }}>{{ block.settings.title }}</h3>
              {% endif %}
            {%- when 'item' -%}
              <details class="rm-faq-item" {{ block.shopify_attributes }}>
                <summary class="rm-faq-question">
                  <span>{{ block.settings.question }}</span>
                  <span class="rm-faq-chevron" aria-hidden="true"></span>
                </summary>
                <div class="rm-faq-answer rte">
                  {{ block.settings.answer }}
                </div>
              </details>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  .rm-faq.section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .rm-faq-inner {
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .rm-faq-heading {
    text-align: {{ section.settings.heading_alignment }};
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    font-size: clamp(2.4rem, 3.5vw, {{ section.settings.heading_size }}px);
    letter-spacing: 0.06em;
    line-height: 1.2;
    margin: 0 0 2.4rem;
    text-transform: uppercase;
    color: #312110;
  }

  .rm-faq-intro {
    text-align: {{ section.settings.heading_alignment }};
    margin: -0.8rem auto 2.5rem;
    max-width: 48rem;
    font-family: var(--font-body-family);
    font-weight: var(--font-body-weight);
    font-size: 1.6rem;
    line-height: 1.65;
    color: rgba(49, 33, 16, 0.82);
  }

  .rm-faq-items {
    border-top: 1px solid rgba(49, 33, 16, 0.12);
  }

  .rm-faq-category {
    margin: 2.8rem 0 0.6rem;
    padding-top: 0.25rem;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.3rem;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
    color: rgba(49, 33, 16, 0.72);
  }

  .rm-faq-items > .rm-faq-category:first-child {
    margin-top: 1.2rem;
    padding-top: 0;
  }

  .rm-faq-item {
    border-bottom: 1px solid rgba(49, 33, 16, 0.12);
    padding: 0;
  }

  .rm-faq-question {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0;
    min-height: 48px;
    font-family: var(--font-body-family);
    font-weight: 600;
    font-size: 1.7rem;
    line-height: 1.35;
    color: #312110;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .rm-faq-question > span:first-child {
    flex: 1 1 auto;
    min-width: 0;
    text-align: left;
    overflow-wrap: anywhere;
  }

  .rm-faq-item summary::-webkit-details-marker,
  .rm-faq-item summary::marker {
    display: none;
  }

  .rm-faq-chevron {
    flex-shrink: 0;
    width: 0.9rem;
    height: 0.9rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    margin-top: -0.3rem;
    opacity: 0.55;
    transition: transform 0.2s ease;
  }

  .rm-faq-item[open] .rm-faq-chevron {
    transform: rotate(225deg);
    margin-top: 0.2rem;
  }

  .rm-faq-answer {
    padding: 0 0 1.6rem;
    font-family: var(--font-body-family);
    font-weight: var(--font-body-weight);
    font-size: 1.55rem;
    line-height: 1.7;
    color: rgba(49, 33, 16, 0.84);
  }

  .rm-faq-answer p {
    margin: 0 0 0.85em;
  }

  .rm-faq-answer p:last-child {
    margin-bottom: 0;
  }

  .rm-faq-answer a {
    color: #312110;
    text-decoration: underline;
    text-underline-offset: 0.2rem;
    word-break: break-word;
  }

  @media screen and (max-width: 749px) {
    .rm-faq-inner {
      padding: 0 1.2rem;
    }

    .rm-faq-heading {
      font-size: 2.4rem;
      margin-bottom: 2rem;
      letter-spacing: 0.05em;
    }

    .rm-faq-intro {
      font-size: 1.5rem;
      margin-bottom: 2rem;
    }

    .rm-faq-category {
      margin-top: 2.2rem;
      font-size: 1.2rem;
      letter-spacing: 0.08em;
    }

    .rm-faq-question {
      font-size: 1.55rem;
      padding: 1.25rem 0;
      gap: 1.2rem;
    }

    .rm-faq-answer {
      font-size: 1.45rem;
      padding-bottom: 1.35rem;
    }
  }
{% endstyle %}

{%- comment -%}
  FAQPage JSON-LD for the full FAQ page (/pages/moonridge-faqs) and any
  template using this collapsible FAQ section.
{%- endcomment -%}
{%- liquid
  assign faq_schema_count = 0
  for block in section.blocks
    if block.type == 'item' and block.settings.question != blank and block.settings.answer != blank
      assign faq_schema_count = faq_schema_count | plus: 1
    endif
  endfor
-%}
{% if faq_schema_count > 0 and section.settings.emit_faq_schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign faq_schema_first = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'item' and block.settings.question != blank and block.settings.answer != blank -%}
        {%- unless faq_schema_first -%},{%- endunless -%}
        {%- assign faq_schema_first = false -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ block.settings.answer | strip_html | json }}
      }
    }
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{% endif %}

{% schema %}
{
  "name": "FAQ accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "checkbox",
      "id": "emit_faq_schema",
      "label": "Emit FAQ schema (JSON-LD)",
      "default": true,
      "info": "Adds FAQPage structured data from the questions below for Google and AI answer engines."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Heading size (desktop max)",
      "default": 36
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "info": "Optional text below the heading (hours, contact, etc.)"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 900
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "General"
        }
      ]
    },
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your question?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Add a clear answer here. You can use links, bold text, and short lists.</p>"
        }
      ]
    }
  ],
  "max_blocks": 80,
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        {
          "type": "category",
          "settings": { "title": "Shopping with us" }
        },
        {
          "type": "item",
          "settings": {
            "question": "Do you ship hats?",
            "answer": "<p>Yes — we ship nationwide. Shipping options appear at checkout, and we pack hats carefully so they arrive ready to wear.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "How do I find my hat size?",
            "answer": "<p>Visit us in Fayetteville for an in-person fitting, or use the sizing resources on each hat product page. You can also book a virtual consultation for one-on-one help.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
