{%- liquid
  assign social_urls = ''
  if settings.social_facebook_link != blank and settings.social_facebook_link != '#'
    assign social_urls = social_urls | append: settings.social_facebook_link | append: '|'
  endif
  if settings.social_instagram_link != blank and settings.social_instagram_link != '#'
    assign social_urls = social_urls | append: settings.social_instagram_link | append: '|'
  endif
  if settings.social_youtube_link != blank and settings.social_youtube_link != '#'
    assign social_urls = social_urls | append: settings.social_youtube_link | append: '|'
  endif
  if settings.social_twitter_link != blank and settings.social_twitter_link != '#'
    assign social_urls = social_urls | append: settings.social_twitter_link | append: '|'
  endif
  if settings.social_pinterest_link != blank and settings.social_pinterest_link != '#'
    assign social_urls = social_urls | append: settings.social_pinterest_link | append: '|'
  endif
  if settings.social_tiktok_link != blank and settings.social_tiktok_link != '#'
    assign social_urls = social_urls | append: settings.social_tiktok_link | append: '|'
  endif
  if settings.social_snapchat_link != blank and settings.social_snapchat_link != '#'
    assign social_urls = social_urls | append: settings.social_snapchat_link | append: '|'
  endif
  if settings.social_tumblr_link != blank and settings.social_tumblr_link != '#'
    assign social_urls = social_urls | append: settings.social_tumblr_link | append: '|'
  endif
  if settings.social_vimeo_link != blank and settings.social_vimeo_link != '#'
    assign social_urls = social_urls | append: settings.social_vimeo_link | append: '|'
  endif
  assign social_profiles = social_urls | split: '|'
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ request.origin | append: "/#organization" | json }},
      "name": {{ shop.name | json }},
      "url": {{ request.origin | json }},
      "alternateName": ["Rafter M Hat Company", "Rafter M", "Moon Ridge", "Moonridge", "Arkansas's Original Hat Bar"],
      "description": "Moon Ridge Hats and Heritage (formerly Rafter M Hat Company) is home to Arkansas's Original Hat Bar in Fayetteville. We sell, fit, shape, clean, and customize heritage headwear — including Stetson, Resistol, Charlie 1 Horse, Goorin Bros, Bigalli, and Pendleton — with trained in-store designers at 2852 N College Ave.",
      "knowsAbout": [
        "custom hat bar",
        "hat shaping",
        "cowboy hats",
        "felt hat X-ratings",
        "Stetson",
        "Resistol",
        "hat cleaning and restoration",
        "private hat parties",
        "hat education",
        "cowboy hat crown shapes",
        "cowboy hat brim shapes",
        "felt hat care"
      ],
      {% if settings.logo != blank %}
        "logo": {{ settings.logo | image_url: width: 600 | prepend: "https:" | json }},
      {% endif %}
      {% if shop.phone != blank %}
        "telephone": {{ shop.phone | json }},
      {% endif %}
      "foundingDate": "2019",
      "sameAs": [
        {%- for profile_url in social_profiles -%}
          {%- unless profile_url == blank -%}
            {{ profile_url | json }},
          {%- endunless -%}
        {%- endfor -%}
        "https://www.wikidata.org/wiki/Q139594213",
        "https://moonridgecompany.com",
        "https://raftermhatco.com",
        "https://www.raftermhatco.com"
      ],
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "contactType": "customer service",
          "url": {{ request.origin | append: routes.contact_url | json }}
        }
      ]
    },
    {
      "@type": "LocalBusiness",
      "name": {{ shop.name | json }},
      "alternateName": ["Rafter M Hat Company", "Rafter M", "Moonridge", "Arkansas's Original Hat Bar"],
      "image": {{ "Moon_Ridge_Storefront.jpg" | asset_url | prepend: "https:" | json }},
      "@id": {{ request.origin | append: "/#localbusiness" | json }},
      "url": {{ request.origin | json }},
      "telephone": "(479) 430-2667",
      "priceRange": "$$",
      "description": "Arkansas's Original Hat Bar in Fayetteville — custom hat fitting, shaping, cleaning, and personalization for Stetson, Resistol, and other heritage brands.",
      "hasMap": "https://maps.google.com/?q=2852+N+College+Ave,+Fayetteville,+AR+72703",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "2852 N College Ave",
        "addressLocality": "Fayetteville",
        "addressRegion": "AR",
        "postalCode": "72703",
        "addressCountry": "US"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "11:00",
          "closes": "17:00"
        }
      ],
      "sameAs": [
        {%- for profile_url in social_profiles -%}
          {%- unless profile_url == blank -%}
            {{ profile_url | json }},
          {%- endunless -%}
        {%- endfor -%}
        "https://www.wikidata.org/wiki/Q139594213",
        "https://moonridgecompany.com",
        "https://raftermhatco.com",
        "https://www.raftermhatco.com"
      ]
    }
  ]
}
</script>

{%- assign search_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ request.origin | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {{ search_action_target | json }},
    "query-input": "required name=search_term_string"
  }
}
</script>
