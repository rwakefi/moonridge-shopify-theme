{% render 'events-page-styles' %}

{% if section.settings.hero_video != blank %}
  <div class="events-video-banner" style="--video-alignment: {{ section.settings.video_alignment }};">
    <div class="events-video-banner__bg">
      {%- liquid
        assign poster = section.settings.poster_image | image_url: width: 1600
        assign laptop_video = section.settings.laptop_video | default: section.settings.hero_video
        assign mobile_video = section.settings.mobile_video | default: laptop_video
      -%}
      <video class="events-video--desktop" autoplay loop muted playsinline{% if poster != blank %} poster="{{ poster }}"{% endif %}>
        {%- for source in section.settings.hero_video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
      <video class="events-video--laptop" autoplay loop muted playsinline{% if poster != blank %} poster="{{ poster }}"{% endif %}>
        {%- for source in laptop_video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
      <video class="events-video--mobile" autoplay loop muted playsinline{% if poster != blank %} poster="{{ poster }}"{% endif %}>
        {%- for source in mobile_video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
    </div>
    <div class="events-video-banner__overlay"></div>
    <div class="events-video-banner__inner">
      <div class="events-video-banner__content">
        {% if section.settings.banner_title != blank %}
          <h1 class="events-video-banner__title">{{ section.settings.banner_title | newline_to_br }}</h1>
        {% endif %}
        {% if section.settings.banner_text != blank %}
          <div class="events-video-banner__text">{{ section.settings.banner_text }}</div>
        {% endif %}
        <div class="events-video-banner__buttons">
          <a href="#event-inquiry-form" class="banner-button banner-button--secondary">Event Form</a>
        </div>
      </div>
      {% render 'events-inquiry-form', overlay: true %}
    </div>
    <button type="button" class="events-video-control" id="EventsVideoToggle" aria-label="Pause Video">
      <span class="icon-pause">
        <svg viewBox="0 0 448 512"><path d="M144 479H48c-26.5 0-48-21.5-48-48V79c0-26.5 21.5-48 48-48h96c26.5 0 48 21.5 48 48v352c0 26.5-21.5 48-48 48zm304-48V79c0-26.5-21.5-48-48-48h-96c-26.5 0-48 21.5-48 48v352c0 26.5 21.5 48 48 48h96c26.5 0 48-21.5 48-48z"/></svg>
      </span>
      <span class="icon-play" style="display: none;">
        <svg viewBox="0 0 448 512"><path d="M424.4 214.7L72.4 6.6C43.8-10.3 0 6.1 0 47.9V464c0 37.5 40.7 60.1 72.4 41.3l352-208c31.4-18.5 31.5-64.1 0-82.6z"/></svg>
      </span>
    </button>
  </div>
{% endif %}

<div class="events-directory">
  <div class="events-grid">
    {% for block in section.blocks %}
      {% if block.type == 'category_header' %}
        <div class="event-category-section" id="{{ block.settings.anchor_id | handleize }}" {{ block.shopify_attributes }}>
          <div class="event-category-hero">
            <div class="event-category-hero__media">
              {% if block.settings.video != blank %}
                {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
              {% elsif block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.title | escape }}">
              {% endif %}
            </div>
            <div class="event-category-hero__gradient"></div>
            <div class="event-category-hero__content">
              <div class="event-category-hero__label">Moon Ridge Experience</div>
              <h2>{{ block.settings.title }}</h2>
              {% if block.settings.description != blank %}
                <div class="event-category-hero__desc">{{ block.settings.description }}</div>
              {% endif %}
            </div>
          </div>
          {% if block.settings.image_2 != blank or block.settings.image_3 != blank %}
            <div class="event-category-gallery">
              {% if block.settings.image_2 != blank %}
                <div class="event-category-gallery__item">
                  <img src="{{ block.settings.image_2 | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}">
                </div>
              {% endif %}
              {% if block.settings.image_3 != blank %}
                <div class="event-category-gallery__item">
                  <img src="{{ block.settings.image_3 | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}">
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% elsif block.type == 'event' %}
        <div class="event-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" class="event-card__image">
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'event-card__image' }}
          {% endif %}
          <div class="event-card__content">
            {% if block.settings.date != blank %}
              <div class="event-card__date">{{ block.settings.date }}</div>
            {% endif %}
            <h3 class="event-card__title">{{ block.settings.title }}</h3>
            {% if block.settings.description != blank %}
              <div class="event-card__desc">{{ block.settings.description }}</div>
            {% endif %}
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="event-card__button">{{ block.settings.button_text }}</a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% if section.blocks.size == 0 %}
      <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: #777;">
        <p>No events currently scheduled. Add some blocks in the theme editor!</p>
      </div>
    {% endif %}

    {% comment %} Form lives in the hero when a video is set; otherwise show it here. {% endcomment %}
    {% if section.settings.hero_video == blank %}
      {% render 'events-inquiry-form', overlay: false %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Events Directory",
  "settings": [
    { "type": "video", "id": "hero_video", "label": "Desktop Video (1400px+)", "info": "Ideal size: 1920×1080px (16:9 landscape). Used on large desktop monitors. Required — all other slots fall back to this if left empty." },
    { "type": "image_picker", "id": "poster_image", "label": "Video Poster Image", "info": "Displays while the video is loading. Highly recommended for speed." },
    { "type": "video", "id": "laptop_video", "label": "Laptop Video (990px–1399px) (Optional)", "info": "Ideal size: 1440×810px (16:9 landscape). Optimized for laptop screens. If left empty, the Desktop video will be used." },
    { "type": "video", "id": "mobile_video", "label": "Mobile Video (under 990px) (Optional)", "info": "Ideal size: 1080×1920px (9:16 vertical/portrait). Optimized for phones and tablets. If left empty, the Laptop video (or Desktop if none) will be used." },
    {
      "type": "select", "id": "video_alignment", "label": "Video Focal Point",
      "info": "If the video is cropping, adjust this to focus on the top or bottom.",
      "options": [
        { "value": "center top", "label": "Top (e.g., show heads)" },
        { "value": "center center", "label": "Center" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center center"
    },
    { "type": "textarea", "id": "banner_title", "label": "Video Overlay Title", "info": "Press Enter in this box to create a line break in the heading.", "default": "Make Your Event Special" },
    { "type": "richtext", "id": "banner_text", "label": "Video Overlay Text", "default": "<p>Discover the Moon Ridge experience.</p>" }
  ],
  "blocks": [
    {
      "type": "category_header",
      "name": "Category Heading",
      "settings": [
        { "type": "text", "id": "title", "label": "Category Name", "default": "Weddings" },
        { "type": "image_picker", "id": "image", "label": "Primary Category Image" },
        { "type": "image_picker", "id": "image_2", "label": "Secondary Image (Optional)" },
        { "type": "image_picker", "id": "image_3", "label": "Tertiary Image (Optional)" },
        { "type": "video", "id": "video", "label": "Category Video (Optional)", "info": "If added, this will replace the primary image with a looping video." },
        { "type": "richtext", "id": "description", "label": "Category Description (Optional)" },
        { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Used for dropdown links. Example: 'weddings'. The link will be /pages/events#weddings", "default": "weddings" }
      ]
    },
    {
      "type": "event",
      "name": "Event",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Event Image" },
        { "type": "text", "id": "date", "label": "Date & Time", "default": "Oct 15, 2026 | 6:00 PM" },
        { "type": "text", "id": "title", "label": "Event Title", "default": "Hat Shaping Workshop" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Learn the art of custom hat shaping with our expert team.</p>" },
        { "type": "text", "id": "button_text", "label": "Button Text", "default": "RSVP Now" },
        { "type": "url", "id": "link", "label": "Event Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Events Directory",
      "blocks": [
        { "type": "category_header", "settings": { "title": "Weddings", "anchor_id": "weddings" } },
        { "type": "event" },
        { "type": "category_header", "settings": { "title": "In Store", "anchor_id": "in-store" } },
        { "type": "event" }
      ]
    }
  ]
}
{% endschema %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const videoToggle = document.getElementById('EventsVideoToggle');
    if (!videoToggle) return;
    const videos = document.querySelectorAll('.events-video-banner__bg video');
    const pauseIcon = videoToggle.querySelector('.icon-pause');
    const playIcon = videoToggle.querySelector('.icon-play');
    videoToggle.addEventListener('click', function() {
      let isCurrentlyPaused = false;
      videos.forEach(v => {
        if (getComputedStyle(v).display !== 'none') {
          isCurrentlyPaused = v.paused;
        }
      });
      videos.forEach(video => {
        if (isCurrentlyPaused) { video.play(); } else { video.pause(); }
      });
      if (isCurrentlyPaused) {
        pauseIcon.style.display = 'block';
        playIcon.style.display = 'none';
        videoToggle.setAttribute('aria-label', 'Pause Video');
      } else {
        pauseIcon.style.display = 'none';
        playIcon.style.display = 'block';
        videoToggle.setAttribute('aria-label', 'Play Video');
      }
    });
  });
</script>
