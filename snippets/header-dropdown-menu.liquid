{% comment %}
  Renders a standard dropdown style menu for the header.

  Usage:
  {% render 'header-dropdown-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- render 'header-menu-nav-divider', link: link -%}
      {%- render 'hats-hub-nav', link: link -%}
      {%- liquid
        assign hat_education_menu_match = false
        assign hat_education_blog = blogs['hat-education']
        assign hat_education_blog_url = '/blogs/hat-education'
        if hat_education_blog != blank
          assign hat_education_blog_url = hat_education_blog.url
        endif
        assign link_title_lc = link.title | downcase | strip
        assign menu_parent_url = ''
        if link.handle == 'experiences' or link_title_lc == 'experiences'
          assign menu_parent_url = '/pages/book-moonridge'
        endif
        if link.handle == 'hat-education' or link_title_lc contains 'hat education'
          assign hat_education_menu_match = true
          assign menu_parent_url = hat_education_blog_url
        endif
        assign roots_blog = blogs['roots']
        assign roots_blog_url = '/blogs/roots'
        if roots_blog != blank
          assign roots_blog_url = roots_blog.url
        endif
        if link.handle == 'roots' or link_title_lc == 'roots'
          assign menu_parent_url = roots_blog_url
        endif
      -%}
      <li>
        {%- if hats_hub_match -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ hats_hub_url }}"
            class="header__menu-item list-menu__item link link--text focus-inset{% if link.current %} header__menu-item--active{% endif %}"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.child_active or link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- elsif hat_education_menu_match -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
                {% if menu_parent_url != blank %}
                  data-href="{{ menu_parent_url }}"
                {% endif %}
              >
                <span
                  {%- if link.child_active or link.current %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {% render 'icon-caret' %}
              </summary>
              <div id="HeaderMenu-MenuList-{{ forloop.index }}">
                {% render 'hat-education-header-dropdown',
                  link: link,
                  variant: 'dropdown',
                  edu_blog: hat_education_blog,
                  edu_blog_url: hat_education_blog_url
                %}
              </div>
            </details>
          </header-menu>
        {%- elsif link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
                {% if menu_parent_url != blank %}
                  data-href="{{ menu_parent_url }}"
                {% endif %}
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {% render 'icon-caret' %}
              </summary>
              <ul
                id="HeaderMenu-MenuList-{{ forloop.index }}"
                class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
                role="list"
                tabindex="-1"
              >
                {%- for childlink in link.links -%}
                  <li>
                    {%- if childlink.links == blank -%}
                      <a
                        id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current %} list-menu__item--active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ childlink.title | escape }}
                      </a>
                    {%- else -%}
                      <details id="Details-HeaderSubMenu-{{ link.handle }}-{{ childlink.handle }}">
                        <summary
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                          class="header__menu-item link link--text list-menu__item focus-inset caption-large"
                        >
                          <span>{{ childlink.title | escape }}</span>
                          {% render 'icon-caret' %}
                        </summary>
                        <ul
                          id="HeaderMenu-SubMenuList-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                          class="header__submenu list-menu motion-reduce"
                        >
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{{ grandchildlink.url }}"
                                class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if grandchildlink.current %} list-menu__item--active{% endif %}"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{ grandchildlink.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
