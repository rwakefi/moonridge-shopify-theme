{% comment %}
  In-stock hats for Hat Education — magazine rail, not a hard sell.

  Optional: shop_collection, featured_product, heading, subheading, view_all_label, unique_id

  If no collection is passed, map the article handle (or a collection-reference
  metafield custom.shop_collection). Fallback: western-hats.
  How to Store a Cowboy Hat features A Better Hat Can unless custom.shop_product is set.
  Collection rails use the homepage Best Sellers carousel (chocolate arrows, hover image, gold dots).
{% endcomment %}

{%- liquid
  assign he_shop = shop_collection
  assign he_heading = heading
  assign he_sub = subheading
  assign he_view = view_all_label | default: 'Shop the collection'
  assign he_id = unique_id | default: 'hat-ed-shop'

  if he_shop == blank and article != blank
    assign he_meta = article.metafields.custom.shop_collection.value
    if he_meta != blank
      assign he_shop = he_meta
    endif
  endif

  if he_shop == blank and article != blank
    assign he_handle = article.handle | downcase
    assign mapped = 'western-hats'
    if he_handle == 'types-of-straw-in-straw-hats'
      assign mapped = 'straw-hats'
    elsif he_handle == 'understanding-the-x-rating-of-hats' or he_handle == 'how-to-clean-a-felt-hat'
      assign mapped = 'felt-hats'
    elsif he_handle == 'learn-your-head-shape' or he_handle == 'finding-the-style-that-fits-your-face'
      assign mapped = 'hats-for-everyone'
    endif
    assign he_shop = collections[mapped]
  endif

  if he_shop == blank
    assign he_shop = collections['western-hats']
  endif

  assign he_feature = featured_product
  if he_feature == blank and article != blank
    assign he_prod_meta = article.metafields.custom.shop_product.value
    if he_prod_meta != blank
      assign he_feature = he_prod_meta
    endif
  endif
  if he_feature == blank and article != blank and article.handle == 'how-to-store-a-cowboy-hat'
    assign he_feature = all_products['a-better-hat-can']
  endif

  if he_heading == blank
    assign he_heading = 'On the wall'
  endif
  if article != blank and article.handle == 'how-to-store-a-cowboy-hat' and he_feature != blank
    assign he_heading = 'A Better Hat Can'
    assign he_sub = 'Stackable cowboy hat case. Made in Gainesville, Texas — the first real upgrade to hat storage we have put on the shelf.'
    assign he_view = 'See the hat can'
  endif

  if he_sub == blank and article != blank
    assign he_handle = article.handle | downcase
    if he_handle == 'types-of-straw-in-straw-hats'
      assign he_sub = 'Bangora, shantung, palm — straw we actually keep in stock.'
    elsif he_handle == 'understanding-the-x-rating-of-hats' or he_handle == 'how-to-clean-a-felt-hat'
      assign he_sub = 'Felt you can try on, then take home or leave with us to shape.'
    elsif he_handle == 'cowboy-hat-crown-shapes' or he_handle == 'cowboy-hat-brim-shapes'
      assign he_sub = 'Same crease names as the product pages. See them on a real hat.'
    elsif he_handle == 'felt-vs-straw-cowboy-hats'
      assign he_sub = 'Felt for cool mornings. Straw when Arkansas heats up.'
    elsif he_handle == 'finding-the-style-that-fits-your-face' or he_handle == 'learn-your-head-shape'
      assign he_sub = 'Start with a shape. Finish it on your head.'
    elsif he_handle == 'how-to-store-a-cowboy-hat'
      assign he_sub = 'A hat worth storing right.'
    else
      assign he_sub = 'Hats from this guide, ready to try on or ship.'
    endif
  endif

  if he_sub == blank
    assign he_sub = 'Hats we stand behind — try them in Fayetteville or order from here.'
  endif

  assign he_limit = 12
  assign he_shown = 0
  if he_shop != blank
    for product in he_shop.products limit: 50
      if product.available and product.featured_media
        assign he_shown = he_shown | plus: 1
      endif
      if he_shown >= he_limit
        break
      endif
    endfor
  endif
-%}

{%- if he_feature != blank and he_feature.featured_media -%}
  {%- assign he_feature_hover = nil -%}
  {%- for media in he_feature.media -%}
    {%- if media.id != he_feature.featured_media.id and media.media_type == 'image' -%}
      {%- assign he_feature_hover = media -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  <aside class="he-shop he-shop--feature" aria-label="{{ he_heading | escape }}">
    <div class="he-shop__inner he-shop__inner--feature page-width">
      <a class="he-shop__feature" href="{{ he_feature.url }}">
        <div class="he-shop__feature-media">
          <img
            class="he-shop__feature-img"
            src="{{ he_feature.featured_media | image_url: width: 1200 }}"
            alt="{{ he_feature.featured_media.alt | default: he_feature.title | escape }}"
            width="600"
            height="600"
            loading="lazy"
          >
          {%- if he_feature_hover != blank -%}
            <img
              class="he-shop__feature-img he-shop__feature-img--hover"
              src="{{ he_feature_hover | image_url: width: 1200 }}"
              alt=""
              width="600"
              height="600"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        <div class="he-shop__feature-copy">
          <p class="he-shop__eyebrow">From the shop</p>
          <h2 class="he-shop__heading">{{ he_heading | escape }}</h2>
          {%- if he_sub != blank -%}
            <p class="he-shop__sub">{{ he_sub | escape }}</p>
          {%- endif -%}
          {%- if he_feature.handle == 'a-better-hat-can' -%}
            <ul class="he-shop__specs">
              <li>Stackable</li>
              <li>Fits a 5″ brim</li>
              <li>Made in Gainesville, TX</li>
            </ul>
          {%- endif -%}
          <p class="he-shop__price">{{ he_feature.price | money }}</p>
          <span class="he-shop__btn">{{ he_view | escape }}</span>
        </div>
      </a>
    </div>
  </aside>
{%- elsif he_shop != blank and he_shown > 0 -%}
  <script src="{{ 'hat-education-carousel.js' | asset_url }}" defer="defer"></script>
  <aside class="he-shop he-shop--carousel" aria-label="{{ he_heading | escape }}">
    <div class="he-shop__inner page-width">
      <header class="he-shop__header">
        <p class="he-shop__eyebrow">From the shop</p>
        <h2 class="he-shop__heading">{{ he_heading | escape }}</h2>
        {%- if he_sub != blank -%}
          <p class="he-shop__sub">{{ he_sub | escape }}</p>
        {%- endif -%}
      </header>

      <he-product-carousel
        class="he-shop__carousel"
        id="{{ he_id }}"
        data-per-view="4"
        data-per-view-tablet="3"
        data-gap="20"
      >
        <div
          class="he-shop__stage moonridge-carousel-wrapper"
          style="--mr-carousel-btn-bg: #312110; --mr-carousel-btn-color: #ffffff; --mr-carousel-btn-hover-bg: #1f1d24;"
        >
          <div class="he-shop__viewport moonridge-carousel-stage">
            <div class="he-shop__track-wrap" data-track-wrap>
              <div class="he-shop__track" data-track>
                {%- assign he_shown = 0 -%}
                {%- for product in he_shop.products limit: 50 -%}
                  {%- if he_shown >= he_limit -%}
                    {%- break -%}
                  {%- endif -%}
                  {%- unless product.available and product.featured_media -%}
                    {%- continue -%}
                  {%- endunless -%}
                  {%- assign he_shown = he_shown | plus: 1 -%}
                  {%- assign he_hover = nil -%}
                  {%- for media in product.media -%}
                    {%- if media.id != product.featured_media.id and media.media_type == 'image' -%}
                      {%- assign he_hover = media -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <article class="he-shop__slide">
                    <a class="he-shop__card" href="{{ product.url }}">
                      <div class="he-shop__media">
                        <img
                          class="he-shop__img"
                          src="{{ product.featured_media | image_url: width: 600 }}"
                          alt="{{ product.featured_media.alt | default: product.title | escape }}"
                          width="600"
                          height="600"
                          loading="lazy"
                        >
                        {%- if he_hover != blank -%}
                          <img
                            class="he-shop__img he-shop__img--hover"
                            src="{{ he_hover | image_url: width: 600 }}"
                            alt=""
                            width="600"
                            height="600"
                            loading="lazy"
                          >
                        {%- endif -%}
                      </div>
                      <div class="he-shop__info">
                        <h3 class="he-shop__title">{{ product.title | escape }}</h3>
                        <p class="he-shop__card-price">
                          <span>{{ product.price | money }}</span>
                          {%- if product.compare_at_price > product.price -%}
                            <s>{{ product.compare_at_price | money }}</s>
                          {%- endif -%}
                        </p>
                      </div>
                    </a>
                  </article>
                {%- endfor -%}
              </div>
            </div>

            <div class="moonridge-carousel-controls" data-controls>
              <button
                type="button"
                class="moonridge-carousel-btn moonridge-carousel-btn--prev"
                aria-label="Previous hats"
                data-prev
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
              <button
                type="button"
                class="moonridge-carousel-btn moonridge-carousel-btn--next"
                aria-label="Next hats"
                data-next
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </div>
          </div>

          <div class="he-shop__dots" data-dots></div>
        </div>
      </he-product-carousel>

      {%- if he_shop.url != blank -%}
        <p class="he-shop__all">
          <a href="{{ he_shop.url }}">{{ he_view | escape }} →</a>
        </p>
      {%- endif -%}
    </div>
  </aside>
{%- endif -%}

<style>
  .he-shop {
    --he-ink: #312110;
    --he-accent: #c5a059;
    --he-cream: #f6f2ec;
    margin: 0;
    padding: 2.75rem 0 3rem;
    background: var(--he-cream);
    border-top: 1px solid rgba(49, 33, 16, 0.08);
    border-bottom: 1px solid rgba(49, 33, 16, 0.08);
    overflow: visible;
  }

  .he-shop__inner {
    max-width: 1100px;
    overflow: visible;
  }

  .he-shop--carousel .he-shop__inner {
    max-width: var(--page-width);
  }

  .he-shop__header {
    text-align: center;
    margin: 0 auto 2rem;
    max-width: 40rem;
  }

  .he-shop--carousel .he-shop__header {
    margin-bottom: 2.25rem;
  }

  .he-shop--carousel .he-shop__header::after {
    content: '';
    display: block;
    width: 2.5rem;
    height: 1px;
    margin: 1.25rem auto 0;
    background: var(--he-accent);
  }

  .he-shop__eyebrow {
    margin: 0 0 0.65rem;
    font-size: 1.2rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--he-accent);
    font-family: var(--font-heading-family);
  }

  .he-shop__heading {
    margin: 0 0 0.65rem;
    font-family: var(--font-heading-family);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--he-ink);
  }

  .he-shop__sub {
    margin: 0;
    font-size: 1.6rem;
    line-height: 1.55;
    color: rgba(49, 33, 16, 0.78);
  }

  .he-shop__carousel {
    display: block;
  }

  .he-shop__stage {
    position: relative;
  }

  .he-shop__viewport {
    position: relative;
  }

  .he-shop__track-wrap {
    position: relative;
    overflow: hidden;
  }

  .he-shop__track {
    display: flex;
    gap: 20px;
    transition: transform 0.35s cubic-bezier(0.645, 0.045, 0.355, 1);
    will-change: transform;
  }

  .he-shop__track.is-animating {
    animation: he-shop-swipe 0.25s ease-out;
  }

  @keyframes he-shop-swipe {
    from { opacity: 0.88; }
    to { opacity: 1; }
  }

  .he-shop__slide {
    flex: 0 0 calc((100% - 60px) / 4);
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .he-shop__track {
      gap: var(--grid-desktop-horizontal-spacing, 16px);
    }

    .he-shop__slide {
      flex: 0 0 var(--he-slide-width, 25%);
      max-width: var(--he-slide-width, none);
    }
  }

  .he-shop__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 1px solid rgba(49, 33, 16, 0.1);
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.45s cubic-bezier(0.2, 0, 0, 1),
      box-shadow 0.45s cubic-bezier(0.2, 0, 0, 1);
  }

  .he-shop__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(49, 33, 16, 0.08);
  }

  .he-shop__media {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background: #f4f4f4;
  }

  .he-shop__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), transform 0.6s ease;
  }

  .he-shop__img--hover {
    opacity: 0;
    pointer-events: none;
  }

  .he-shop__card:has(.he-shop__img--hover):hover .he-shop__img:not(.he-shop__img--hover) {
    opacity: 0;
  }

  .he-shop__card:hover .he-shop__img--hover {
    opacity: 1;
  }

  .he-shop__info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.95rem 1rem 1.15rem;
    flex-grow: 1;
  }

  .he-shop__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(1.5rem, 1.4vw, 1.7rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--he-ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .he-shop__card-price {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    letter-spacing: 0.04em;
    color: var(--he-ink);
  }

  .he-shop__card-price s {
    color: rgba(49, 33, 16, 0.45);
    font-size: 1.35rem;
  }

  .he-shop__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 7px;
    padding: 1.15rem 0 0;
  }

  .he-shop__dot {
    width: 7px;
    height: 7px;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: rgba(49, 33, 16, 0.22);
    cursor: pointer;
    appearance: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .he-shop__dot:hover {
    background: rgba(49, 33, 16, 0.45);
  }

  .he-shop__dot.is-active {
    background: var(--he-accent);
    transform: scale(1.25);
  }

  .he-shop__carousel.is-single .moonridge-carousel-controls,
  .he-shop__carousel.is-single .he-shop__dots {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .he-shop__track {
      flex-wrap: wrap;
      gap: 12px;
    }

    .he-shop__slide {
      flex: 0 0 calc((100% - 12px) / 2);
      max-width: calc((100% - 12px) / 2);
    }

    .he-shop__info {
      padding: 0.7rem 0.75rem 0.9rem;
    }

    .he-shop__title {
      font-size: 1.5rem;
    }
  }

  .he-shop__all {
    margin: 1.75rem 0 0;
    text-align: center;
  }

  .he-shop__all a {
    font-size: 1.4rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--he-accent);
    text-decoration: none;
    font-family: var(--font-heading-family);
  }

  .he-shop__all a:hover {
    color: var(--he-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .he-shop__inner--feature {
    max-width: 960px;
  }

  .he-shop__feature {
    display: grid;
    gap: 1.75rem;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  @media screen and (min-width: 750px) {
    .he-shop__feature {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 2.5rem;
    }
  }

  .he-shop__feature-media {
    position: relative;
    margin: 0;
    background: #fff;
    border: 1px solid rgba(49, 33, 16, 0.08);
    border-radius: 6px;
    overflow: hidden;
  }

  .he-shop__feature-media img,
  .he-shop__feature-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .he-shop__feature-img--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .he-shop__feature:hover .he-shop__feature-img--hover {
    opacity: 1;
  }

  .he-shop__feature-copy {
    text-align: left;
  }

  .he-shop--feature .he-shop__heading {
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .he-shop--feature .he-shop__heading::after {
    content: '';
    display: block;
    width: 2.5rem;
    height: 1px;
    margin: 0.85rem 0 0;
    background: var(--he-accent);
  }

  .he-shop--feature .he-shop__sub {
    font-size: 1.25rem;
    margin: 1rem 0 1.1rem;
  }

  .he-shop__specs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .he-shop__specs li {
    padding: 0.35rem 0.7rem;
    border: 1px solid rgba(49, 33, 16, 0.14);
    border-radius: 999px;
    font-family: var(--font-heading-family);
    font-size: 1.25rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--he-ink);
  }

  .he-shop__price {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading-family);
    font-size: 1.9rem;
    color: var(--he-ink);
  }

  .he-shop__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.4rem;
    background: var(--he-ink);
    color: #fff;
    border-radius: 4px;
    font-size: 1.25rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: var(--font-heading-family);
  }

  .he-shop__feature:hover .he-shop__btn {
    background: #4a3428;
  }
</style>
