{%- comment -%}
  Pendleton brand film, shown under the Pendleton brand-page body.
  Video is stored as a page metafield (custom.brand_video) so it can be
  swapped or removed from the page's metafields without a code change.
  Poster is a still frame pulled from the video and uploaded as a Shopify file.
{%- endcomment -%}

{%- liquid
  assign video = page.metafields.custom.brand_video.value
  assign poster_url = 'https://cdn.shopify.com/s/files/1/0885/7180/6000/files/pendleton-brand-video-poster.jpg?v=1789475471'
  assign video_title = 'Pendleton Woolen Mills'
  assign video_caption = 'Pendleton Woolen Mills — Woven in Oregon Since 1863'
-%}

{%- if video != blank -%}
<style>
  .pbv {
    margin: 36px auto 0;
    max-width: min(68rem, 92vw);
  }

  .pbv__heading {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: 24px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #312110;
    text-align: center;
    margin: 0 0 28px;
  }

  .pbv__wrap {
    max-width: 640px;
    margin: 0 auto;
  }

  .pbv__frame {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background: #1f1d24;
    border-radius: 2px;
    overflow: hidden;
  }

  .pbv__frame video,
  .pbv__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .pbv__frame video {
    object-fit: cover;
    background: #1f1d24;
  }

  .pbv__poster {
    padding: 0;
    margin: 0;
    cursor: pointer;
    background: #1f1d24;
    color: #faf7f2;
  }

  .pbv__poster:focus-visible {
    outline: 2px solid #312110;
    outline-offset: 3px;
  }

  .pbv__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pbv__play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    border-radius: 50%;
    background: rgba(49, 33, 16, 0.88);
    color: #faf7f2;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .pbv__play .icon-play {
    width: 16px;
    height: 22px;
    margin-left: 3px;
  }

  .pbv__poster:hover .pbv__play {
    background: #312110;
  }

  .pbv__caption {
    font-family: var(--font-heading-family);
    font-size: 16px;
    line-height: 1.4;
    color: #312110;
    text-align: center;
    margin: 12px 0 0;
  }
</style>

<div class="pbv">
  <h2 class="pbv__heading">See the work</h2>
  <div class="pbv__wrap">
    <figure class="pbv__item">
      <div class="pbv__frame">
        <button
          type="button"
          class="pbv__poster"
          aria-label="Play {{ video_title | escape }} video"
        >
          <img
            src="{{ poster_url }}"
            alt="{{ video_title | escape }}"
            width="1280"
            height="720"
            loading="lazy"
          >
          <span class="pbv__play" aria-hidden="true">{% render 'icon-play' %}</span>
        </button>
        <template class="pbv__video-template">
          {{ video | video_tag: image_size: '1100x', autoplay: true, controls: true, muted: false }}
        </template>
      </div>
      {%- if video_caption != blank -%}
        <figcaption class="pbv__caption">{{ video_caption }}</figcaption>
      {%- endif -%}
    </figure>
  </div>
</div>

<script>
  (function () {
    document.querySelectorAll('.pbv__poster').forEach(function (button) {
      button.addEventListener('click', function () {
        var frame = button.closest('.pbv__frame');
        var template = frame.querySelector('.pbv__video-template');
        if (!template) return;
        var node = template.content.firstElementChild.cloneNode(true);
        button.replaceWith(node);
        var videoEl = node.tagName === 'VIDEO' ? node : node.querySelector('video');
        if (videoEl) {
          videoEl.play().catch(function () {});
        }
      });
    });
  })();
</script>
{%- endif -%}
