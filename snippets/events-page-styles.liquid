{% style %}
  /* Hide breadcrumbs on events page (mobile + desktop) */
  .breadcrumbs {
    display: none !important;
  }

  html {
    scroll-behavior: smooth;
  }

  /* Three-way video swap: mobile / laptop / desktop */
  video.events-video--mobile  { display: none !important; }
  video.events-video--laptop  { display: none !important; }
  /* Laptop (990px–1399px) */
  @media screen and (min-width: 990px) and (max-width: 1399px) {
    video.events-video--desktop { display: none !important; }
    video.events-video--laptop  { display: block !important; }
  }
  /* Mobile (up to 989px) */
  @media screen and (max-width: 989px) {
    video.events-video--desktop { display: none !important; }
    video.events-video--mobile  { display: block !important; }
  }
  .events-video-banner {
    position: relative;
    width: 100%;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #000;
  }
  .events-video-banner__bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .events-video-banner__bg video {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: var(--video-alignment, center center);
    display: block;
  }
  .events-video-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    z-index: 2;
  }
  .events-video-banner__content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: #ffffff;
    max-width: 800px;
    padding: 0 20px;
  }
  .events-video-banner__title {
    font-family: var(--font-heading-family);
    font-size: 56px;
    font-weight: 700;
    margin: 0 0 16px 0;
    color: #fff;
    line-height: 1.05;
    letter-spacing: 0.01em;
  }
  .events-video-banner__text {
    font-size: 18px;
    margin: 0 0 32px 0;
    color: #fff;
    line-height: 1.5;
  }
  .events-video-banner__buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .banner-button {
    display: inline-block;
    padding: 14px 32px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .banner-button--primary { background: #ffffff; color: #111111; }
  .banner-button--primary:hover { background: #e6e6e6; }
  .banner-button--secondary { background: transparent; color: #ffffff; border: 1px solid #ffffff; }
  .banner-button--secondary:hover { background: rgba(255,255,255,0.1); }

  /* ── Title stacked above a transparent form, all over the hero video ── */
  .events-video-banner__inner {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1040px;
    margin: 0 auto;
    padding: 56px 24px 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }
  .events-video-banner__inner .events-video-banner__content {
    text-align: center;
    max-width: none;
    padding: 0;
  }
  .events-video-banner__inner .events-video-banner__title {
    margin: 0;
    font-size: 40px;
    line-height: 1.2;
    text-shadow: 0 2px 16px rgba(0,0,0,0.5);
  }
  .events-video-banner__inner .events-video-banner__text { margin: 12px 0 0; }
  .events-video-banner__inner .events-video-banner__buttons { display: none; }

  .events-form-wrapper.events-form-wrapper--overlay {
    --color-foreground: 255, 255, 255;
    margin: 0;
    max-width: 732px;
    width: 100%;
    padding: 28px 32px 32px;
    background: rgba(0, 0, 0, 0.34);
    border: 1px solid rgba(255, 255, 255, 0.35);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    box-shadow: none;
    color: #fff;
  }
  .events-form-wrapper--overlay .events-form-grid { gap: 12px; }
  .events-form-wrapper--overlay .field__input {
    background: transparent !important;
    color: #fff !important;
    caret-color: #fff;
  }
  .events-form-wrapper--overlay .field:after,
  .events-form-wrapper--overlay .field:before {
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.75) !important;
  }
  .events-form-wrapper--overlay .field:hover:after {
    box-shadow: 0 0 0 1.5px #fff !important;
  }
  .events-form-wrapper--overlay .field__label { color: rgba(255, 255, 255, 0.85) !important; }
  .events-form-wrapper--overlay .field__input::placeholder { color: rgba(255, 255, 255, 0.7); }
  .events-form-wrapper--overlay .field__input:-webkit-autofill {
    -webkit-text-fill-color: #fff;
    -webkit-box-shadow: 0 0 0 1000px rgba(0, 0, 0, 0.35) inset;
    transition: background-color 9999s ease-in-out 0s;
  }
  .events-form-wrapper--overlay .events-form-grid .field--date .field__input { color-scheme: dark; }
  .events-form-wrapper--overlay .form__message,
  .events-form-wrapper--overlay .form-status { color: #fff !important; }

  .events-video-control {
    position: absolute;
    bottom: 30px;
    right: 30px;
    z-index: 10;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    opacity: 0.6;
    padding: 0;
  }
  .events-video-control:hover {
    opacity: 1;
    background: rgba(0, 0, 0, 0.6);
    transform: scale(1.05);
  }
  .events-video-control svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }
  @media screen and (min-width: 750px) and (max-width: 1099px) {
    .events-video-banner__inner .events-video-banner__title { font-size: 34px; }
  }
  @media screen and (max-width: 749px) {
    .events-video-control {
      bottom: 16px;
      right: 16px;
      width: 38px;
      height: 38px;
    }
    .events-video-banner__inner { padding: 36px 16px 64px; gap: 20px; }
    .events-video-banner__inner .events-video-banner__title { font-size: 26px; line-height: 1.25; }
    .events-form-wrapper.events-form-wrapper--overlay { padding: 20px 16px 24px; }
  }

  /* Events directory body */
  .events-directory {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
    font-family: var(--font-body-family);
  }
  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 30px;
  }
  /* ── Cinematic Category Section ────────────────────── */
  .event-category-section {
    grid-column: 1 / -1;
    margin-top: 0;
  }
  .event-category-hero {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #111;
  }
  .event-category-hero__media {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 0;
  }
  .event-category-hero__media img,
  .event-category-hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.55);
  }
  .event-category-hero__gradient {
    position: absolute;
    bottom: 0; left: 0;
    width: 100%; height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.7) 40%, rgba(0,0,0,0.35) 70%, rgba(0,0,0,0.1) 100%);
    z-index: 1;
  }
  .event-category-hero__content {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 40px;
    width: 100%;
  }
  .event-category-hero__label {
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #C5A059;
    margin-bottom: 16px;
  }
  .event-category-hero h2 {
    font-family: var(--font-heading-family);
    font-size: 52px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 20px 0;
    text-transform: uppercase;
    letter-spacing: 3px;
    line-height: 1.1;
    text-shadow: 0 2px 12px rgba(0,0,0,0.6);
  }
  .event-category-hero__desc {
    font-size: 17px;
    color: rgba(255,255,255,0.92);
    max-width: 650px;
    line-height: 1.8;
    text-shadow: 0 1px 6px rgba(0,0,0,0.5);
    text-align: left;
  }
  .event-category-hero__desc p { margin: 0 0 12px 0; }
  .event-category-hero__desc p:last-child { margin-bottom: 0; }
  .event-category-hero__desc strong { color: #fff; }
  /* Gallery row under the hero */
  .event-category-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-bottom: 60px;
  }
  .event-category-gallery__item {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #f0f0f0;
  }
  .event-category-gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .event-category-gallery__item:hover img {
    transform: scale(1.03);
  }
  .event-card { border: 1px solid #eaeaea; border-radius: 8px; overflow: hidden; transition: transform 0.2s, box-shadow 0.2s; }
  .event-card:hover { transform: translateY(-4px); box-shadow: 0 12px 24px rgba(0,0,0,0.06); }
  .event-card__image { width: 100%; height: 200px; object-fit: cover; background: #f5f5f5; }
  .event-card__content { padding: 24px; }
  .event-card__date { display: inline-block; font-size: 13px; font-weight: 600; text-transform: uppercase; color: #C5A059; margin-bottom: 8px; letter-spacing: 0.5px; }
  .event-card__title { font-family: var(--font-heading-family); font-size: 22px; font-weight: 600; margin: 0 0 12px 0; color: #111; }
  .event-card__desc { font-size: 15px; color: #555; line-height: 1.5; margin: 0 0 20px 0; }
  .event-card__button { display: inline-block; padding: 10px 20px; background: #111; color: #fff; text-decoration: none; border-radius: 4px; font-size: 14px; font-weight: 500; transition: background 0.2s; }
  .event-card__button:hover { background: #333; }
  .events-form-wrapper {
    grid-column: 1 / -1;
    max-width: 800px;
    margin: 40px auto 0;
    width: 100%;
    padding: 40px;
    background: #fafafa;
    border-radius: 8px;
    border: 1px solid #eaeaea;
  }
  .events-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .events-form-grid .field--full-width { grid-column: 1 / -1; }
  .events-form-grid .field--date .field__label {
    font-size: 1rem;
    top: calc(var(--inputs-border-width) + 0.5rem);
    left: calc(var(--inputs-border-width) + 2rem);
    letter-spacing: 0.04rem;
    transform: none;
  }
  .events-form-grid .field--date .field__input {
    padding: 2.2rem 1.5rem 0.8rem 2rem;
    color-scheme: light;
  }
  .events-form-grid .field--date .field__input::-webkit-calendar-picker-indicator {
    cursor: pointer;
    opacity: 0.75;
  }

  @media screen and (max-width: 768px) {
    .events-video-banner__title { font-size: 36px; }
    .event-category-hero {
      min-height: 400px;
    }
    .event-category-hero h2 {
      font-size: 32px;
      letter-spacing: 2px;
    }
    .event-category-hero__content {
      padding: 40px 24px;
    }
    .event-category-hero__desc {
      font-size: 15px;
    }
    .event-category-gallery {
      grid-template-columns: 1fr;
      gap: 3px;
    }
    .events-form-wrapper { padding: 24px 20px; }
    .events-form-grid { grid-template-columns: 1fr; }
  }
{% endstyle %}
