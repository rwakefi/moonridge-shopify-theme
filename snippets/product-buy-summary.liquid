{% comment %}
  First paragraph of the product description, for the buying column.
  The remaining paragraphs render below via 'product-description-rest', so the
  opening paragraph is never shown twice. When the description is a single block
  nothing is lifted here and the full description renders below instead.
{% endcomment %}
{%- if product.description != blank -%}
  {%- liquid
    assign legacy_line = 'A Moon Ridge Company Original (Formerly Rafter M). Same master-level shaping, same veteran team.'
    assign source = product.description | replace: legacy_line, ''
    assign summary_html = ''
    if source contains '</p>'
      assign summary_parts = source | split: '</p>'
      if summary_parts.size > 1
        assign summary_html = summary_parts.first | append: '</p>'
      endif
    endif
    assign summary_text = summary_html | strip_html | strip
  -%}
  {%- if summary_text != blank -%}
    <div class="product__buy-summary rte">
      {{ summary_html }}
    </div>
  {%- endif -%}
{%- endif -%}
