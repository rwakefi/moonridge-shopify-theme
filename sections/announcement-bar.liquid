{{ 'component-slider.css' | asset_url | stylesheet_tag }}

<style>
  .section-announcement-bar.shopify-section-group-header-group {
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    color: inherit !important;
  }

  .rm-promo-bar {
    --promo-ink: #312110;
    --promo-gold: #c5a059;
    --promo-cream: #faf8f5;
    --promo-floor: 12px;
    background: #ffffff;
    padding: 0.5rem 1.2rem 0.6rem;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  .rm-promo-bar__grid {
    display: grid;
    gap: 0.7rem;
    width: 100%;
    align-items: stretch;
  }

  .rm-promo-bar__grid[data-count="1"] { grid-template-columns: 1fr; }
  .rm-promo-bar__grid[data-count="2"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .rm-promo-bar__grid[data-count="3"] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .rm-promo-bar__grid[data-count="4"] { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  .rm-promo-bar__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 3.4rem;
    padding: 0.55rem 0.9rem;
    margin: 0;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.55) 0%, rgba(49, 33, 16, 0.04) 100%),
      var(--promo-cream);
    border: 1px solid var(--promo-gold);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    color: var(--promo-ink);
    font-family: var(--font-heading-family, Jost, sans-serif);
    font-size: max(var(--promo-floor), 1.2rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
    overflow-wrap: break-word;
  }

  a.rm-promo-bar__btn:hover {
    border-color: #9c7a52;
    color: var(--promo-ink);
  }

  @media screen and (max-width: 749px) {
    .rm-promo-bar {
      padding: 0.45rem 0.7rem 0.55rem;
    }

    .rm-promo-bar__grid {
      gap: 0.5rem;
    }

    .rm-promo-bar__grid[data-count="2"],
    .rm-promo-bar__grid[data-count="3"],
    .rm-promo-bar__grid[data-count="4"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rm-promo-bar__btn {
      min-height: 3.2rem;
      padding: 0.5rem 0.55rem;
      font-size: var(--promo-floor);
      letter-spacing: 0.05em;
    }
  }

  .rm-announcement-bar {
    background-color: #4a9e9a;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1.6rem;
    font-size: 17px;
    line-height: 1.4;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .rm-announcement-bar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 1200px;
    width: 100%;
    gap: 0.75rem;
  }

  .rm-announcement-track {
    position: relative;
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 1.8em;
    padding: 0 2.5rem;
    overflow: hidden;
  }

  .rm-announcement-slide {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    opacity: 0;
    transition: opacity 0.65s ease-in-out;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    padding: 0 0.25rem;
  }

  .rm-announcement-slide.is-active {
    opacity: 1;
  }

  .rm-announcement-text {
    font-family: var(--font-body-family);
    font-size: 15px;
    letter-spacing: 0.03em;
  }

  .rm-announcement-link {
    color: #ffffff;
    text-decoration: underline;
  }

  .rm-announcement-arrow {
    background: transparent;
    border: none;
    color: #ffffff;
    cursor: pointer;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    flex-shrink: 0;
  }

  .rm-announcement-arrow svg {
    width: 10px;
    height: 10px;
  }

  .rm-announcement-arrow--prev { margin-right: 0.25rem; }
  .rm-announcement-arrow--next { margin-left: 0.25rem; }

  @media screen and (max-width: 749px) {
    .rm-announcement-bar {
      padding: 1rem 0.8rem 0.9rem;
      font-size: 12px;
      line-height: 1.5;
    }

    .rm-announcement-track {
      padding: 0 1.8rem;
      min-height: 3.8em !important;
      display: flex;
      align-items: center;
    }

    .rm-announcement-slide {
      white-space: normal;
      overflow: visible;
    }

    .rm-announcement-text {
      font-size: 12px;
      display: inline-block;
      padding-top: 7px;
    }

    .rm-announcement-arrow {
      width: 1.4rem;
      height: 1.4rem;
    }
  }
</style>

{%- if section.settings.layout == 'three_column' -%}
  {%- liquid
    assign b1_text = section.settings.button_1_text | strip
    assign b2_text = section.settings.button_2_text | strip
    assign b3_text = section.settings.button_3_text | strip
    assign b4_text = section.settings.button_4_text | strip
    assign promo_count = 0
    if b1_text != blank
      assign promo_count = promo_count | plus: 1
    endif
    if b2_text != blank
      assign promo_count = promo_count | plus: 1
    endif
    if b3_text != blank
      assign promo_count = promo_count | plus: 1
    endif
    if b4_text != blank
      assign promo_count = promo_count | plus: 1
    endif
  -%}
  {%- if promo_count > 0 -%}
    <div class="rm-promo-bar" role="navigation" aria-label="Store highlights">
      <div class="rm-promo-bar__grid" data-count="{{ promo_count }}">
        {%- if b1_text != blank -%}
          {%- if section.settings.button_1_link != blank -%}
            <a class="rm-promo-bar__btn" href="{{ section.settings.button_1_link }}">{{ b1_text | escape }}</a>
          {%- else -%}
            <span class="rm-promo-bar__btn">{{ b1_text | escape }}</span>
          {%- endif -%}
        {%- endif -%}
        {%- if b2_text != blank -%}
          {%- if section.settings.button_2_link != blank -%}
            <a class="rm-promo-bar__btn" href="{{ section.settings.button_2_link }}">{{ b2_text | escape }}</a>
          {%- else -%}
            <span class="rm-promo-bar__btn">{{ b2_text | escape }}</span>
          {%- endif -%}
        {%- endif -%}
        {%- if b3_text != blank -%}
          {%- if section.settings.button_3_link != blank -%}
            <a class="rm-promo-bar__btn" href="{{ section.settings.button_3_link }}">{{ b3_text | escape }}</a>
          {%- else -%}
            <span class="rm-promo-bar__btn">{{ b3_text | escape }}</span>
          {%- endif -%}
        {%- endif -%}
        {%- if b4_text != blank -%}
          {%- if section.settings.button_4_link != blank -%}
            <a class="rm-promo-bar__btn" href="{{ section.settings.button_4_link }}">{{ b4_text | escape }}</a>
          {%- else -%}
            <span class="rm-promo-bar__btn">{{ b4_text | escape }}</span>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- elsif section.blocks.size > 0 -%}
  <div class="rm-announcement-bar" id="rm-announcement-{{ section.id }}" role="region" aria-label="Store announcements">
    <div class="rm-announcement-bar-inner">
      {% if section.blocks.size > 1 %}
        <button
          type="button"
          class="rm-announcement-arrow rm-announcement-arrow--prev"
          aria-label="Previous announcement"
        >
          <svg viewBox="0 0 10 10"><path d="M6.5 1L2 5l4.5 4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      {% endif %}

      <div class="rm-announcement-track">
        {% for block in section.blocks %}
          {%- if block.settings.text != blank -%}
            <div
              class="rm-announcement-slide{% if forloop.first %} is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="rm-announcement-text rm-announcement-link">
                  {{ block.settings.text | escape }}
                </a>
              {% else %}
                <span class="rm-announcement-text">{{ block.settings.text | escape }}</span>
              {% endif %}
            </div>
          {%- endif -%}
        {% endfor %}
      </div>

      {% if section.blocks.size > 1 %}
        <button
          type="button"
          class="rm-announcement-arrow rm-announcement-arrow--next"
          aria-label="Next announcement"
        >
          <svg viewBox="0 0 10 10"><path d="M3.5 1L8 5l-4.5 4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      {% endif %}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const bar = document.getElementById('rm-announcement-{{ section.id }}');
      if (!bar) return;

      const slides = bar.querySelectorAll('.rm-announcement-slide');
      if (slides.length === 0) return;

      let currentIndex = 0;
      const baseInterval = {{ section.settings.rotation_interval | default: 7000 }};
      const intervalMs = Math.round(baseInterval * 1.6);
      let timer = null;

      function showSlide(index) {
        slides[currentIndex].classList.remove('is-active');
        currentIndex = (index + slides.length) % slides.length;
        slides[currentIndex].classList.add('is-active');
      }

      function next() { showSlide(currentIndex + 1); }
      function prev() { showSlide(currentIndex - 1); }

      function startLoop() {
        timer = setTimeout(function loop() {
          next();
          timer = setTimeout(loop, intervalMs);
        }, intervalMs);
      }

      function resetLoop() {
        clearTimeout(timer);
        startLoop();
      }

      const nextBtn = bar.querySelector('.rm-announcement-arrow--next');
      const prevBtn = bar.querySelector('.rm-announcement-arrow--prev');
      if (nextBtn) nextBtn.addEventListener('click', () => { next(); resetLoop(); });
      if (prevBtn) prevBtn.addEventListener('click', () => { prev(); resetLoop(); });
      if (slides.length > 1) startLoop();
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement-bar",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "rotating", "label": "Rotating messages" },
        { "value": "three_column", "label": "Button strip" }
      ],
      "default": "rotating"
    },
    {
      "type": "header",
      "content": "Button strip"
    },
    {
      "type": "paragraph",
      "content": "Leave a label blank to hide that button. Clearing a field will not fall back to old copy."
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Button 1 label"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Button 2 label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "text",
      "id": "button_3_text",
      "label": "Button 3 label"
    },
    {
      "type": "url",
      "id": "button_3_link",
      "label": "Button 3 link"
    },
    {
      "type": "text",
      "id": "button_4_text",
      "label": "Button 4 label"
    },
    {
      "type": "url",
      "id": "button_4_link",
      "label": "Button 4 link"
    },
    {
      "type": "header",
      "content": "Rotating messages"
    },
    {
      "type": "range",
      "id": "rotation_interval",
      "min": 3000,
      "max": 9000,
      "step": 1000,
      "unit": "ms",
      "label": "Rotation interval",
      "default": 7000
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Message" },
        { "type": "url", "id": "link", "label": "Optional link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Announcement bar",
      "settings": { "layout": "rotating" }
    },
    {
      "name": "Button strip",
      "settings": { "layout": "three_column" }
    }
  ]
}
{% endschema %}
