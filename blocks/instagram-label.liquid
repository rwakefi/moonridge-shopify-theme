{%- comment -%}
  Quiet Instagram section label. Default live look is the handle with
  small Instagram / TikTok marks. To roll back: Theme editor → this
  block → turn off "Show social icons" and type "On Instagram" in Eyebrow.
{%- endcomment -%}

{%- liquid
  assign ig_url = block.settings.url
  if ig_url == blank
    assign ig_url = settings.social_instagram_link
  endif
  assign tiktok_url = block.settings.tiktok_url
  if tiktok_url == blank
    assign tiktok_url = settings.social_tiktok_link
  endif
-%}
<div class="mr-ig-label" {{ block.shopify_attributes }}>
  {%- if block.settings.eyebrow != blank -%}
    <p class="mr-ig-label__eyebrow">{{ block.settings.eyebrow | escape }}</p>
  {%- endif -%}
  {%- if block.settings.handle != blank or block.settings.show_icons -%}
    <h2 class="mr-ig-label__handle">
      {%- if block.settings.show_icons and ig_url != blank -%}
        <a
          href="{{ ig_url }}"
          class="mr-ig-label__icon mr-ig-label__icon--instagram"
          target="_blank"
          rel="noopener"
          aria-label="Moon Ridge on Instagram"
        >
          {% render 'icon-instagram' %}
        </a>
      {%- endif -%}
      {%- if block.settings.handle != blank -%}
        {%- if ig_url != blank -%}
          <a href="{{ ig_url }}" class="mr-ig-label__link" target="_blank" rel="noopener">
            {{ block.settings.handle | escape }}
          </a>
        {%- else -%}
          {{ block.settings.handle | escape }}
        {%- endif -%}
      {%- endif -%}
      {%- if block.settings.show_icons and tiktok_url != blank -%}
        <a
          href="{{ tiktok_url }}"
          class="mr-ig-label__icon mr-ig-label__icon--tiktok"
          target="_blank"
          rel="noopener"
          aria-label="Moon Ridge on TikTok"
        >
          {% render 'icon-tiktok' %}
        </a>
      {%- endif -%}
    </h2>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Instagram label",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Leave blank to hide. Type “On Instagram” to restore the old heading."
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@moonridgeco"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Instagram URL",
      "info": "Opens the Instagram icon and the handle."
    },
    {
      "type": "text",
      "id": "tiktok_url",
      "label": "TikTok URL",
      "info": "Use a full URL. Falls back to the theme’s TikTok link if blank."
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Show Instagram and TikTok icons",
      "info": "Uncheck to go back to handle-only (or handle + eyebrow).",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Instagram label"
    }
  ]
}
{% endschema %}
