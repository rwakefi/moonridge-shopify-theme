{% comment %}
  Renders product buy-buttons.
  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} product form id.
  - section_id: {String} id of section to which this snippet belongs.
  - show_pickup_availability: {Boolean} for the pickup availability. If true the pickup availability is rendered, false - not rendered (optional).

  Usage:
  {% render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: true %}
{% endcomment %}
<div {{ block.shopify_attributes }}>
  {%- if product != blank -%}
    {%- liquid
      assign gift_card_recipient_feature_active = false
      if block.settings.show_gift_card_recipient and product.gift_card?
        assign gift_card_recipient_feature_active = true
      endif

      assign show_dynamic_checkout = false
      if block.settings.show_dynamic_checkout and gift_card_recipient_feature_active == false
        assign show_dynamic_checkout = true
      endif

      assign sold_out_button_label = 'products.product.sold_out' | t
      assign product_template_suffix = product.template_suffix | default: '' | downcase

      comment
        in_store_only — boots are fitted and sold in the shop, never checked out
        online. The submit button stays disabled regardless of stock, the variant
        id is withheld from the form, and the dynamic checkout buttons (Shop Pay,
        installments) are suppressed so no path bypasses the cart.
      endcomment
      assign in_store_only = false
      if product_template_suffix == 'boots' or product_template_suffix contains 'boot'
        assign sold_out_button_label = 'Contact Store For Availability'
        assign in_store_only = true
        assign show_dynamic_checkout = false
      endif
    -%}

    {%- if in_store_only -%}
      <script>
        /* layout/theme.liquid defines window.variantStrings near the end of
           <body>, i.e. AFTER this snippet renders, so a plain assignment here
           would be overwritten. global.js reads variantStrings.soldOut at call
           time (on every variant change) and would otherwise relabel this
           button "Sold out" the moment a shopper picks a size. Overriding on
           DOMContentLoaded runs after theme.liquid's inline script and keeps
           the whole in-store-only rule inside this one snippet. */
        document.addEventListener('DOMContentLoaded', function () {
          window.variantStrings = window.variantStrings || {};
          window.variantStrings.soldOut = 'Contact Store For Availability';
        });
      </script>
      <style>
        /* Boots cannot be checked out online. The Shop Pay installments offer is
           rendered by the price block in sections/main-product.liquid, outside
           this snippet — hide it here rather than editing that 4,000-line file,
           so the whole in-store-only rule stays in one place. */
        .installment {
          display: none !important;
        }
      </style>
    {%- endif -%}

    <product-form
      class="product-form"
      data-hide-errors="{{ gift_card_recipient_feature_active }}"
      data-section-id="{{ section.id }}"
    >
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <svg
          aria-hidden="true"
          focusable="false"
          class="icon icon-error"
          viewBox="0 0 13 13"
        >
          <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
          <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
          <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
          <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
        </svg>
        <span class="product-form__error-message"></span>
      </div>

      {%- form 'product',
        product,
        id: product_form_id,
        class: 'form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          {% if in_store_only or product.selected_or_first_available_variant.available == false or quantity_rule_soldout %}
            disabled
          {% endif %}
          class="product-variant-id"
        >

        {%- if gift_card_recipient_feature_active -%}
          {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
        {%- endif -%}

        <div class="product-form__buttons">
          {%- liquid
            assign check_against_inventory = true
            if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
              assign check_against_inventory = false
            endif
            if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
              assign quantity_rule_soldout = true
            endif
            assign low_stock_inventory = product.selected_or_first_available_variant.inventory_quantity
            assign show_low_stock_notice = false
            if block.settings.enable_low_stock_notice
              if check_against_inventory and product.selected_or_first_available_variant.available and low_stock_inventory > 0 and low_stock_inventory <= block.settings.low_stock_threshold
                assign show_low_stock_notice = true
              endif
            endif
          -%}
          <button
            id="ProductSubmitButton-{{ section_id }}"
            type="submit"
            name="add"
            class="product-form__submit button button--full-width {% if show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}"
            {% if in_store_only or product.selected_or_first_available_variant.available == false or quantity_rule_soldout %}
              disabled
            {% endif %}
          >
            <span>
              {%- if in_store_only or product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
                {{- sold_out_button_label -}}
              {%- else -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- endif -%}
            </span>
            {%- render 'loading-spinner' -%}
          </button>
          {%- if show_dynamic_checkout -%}
            
        {{ form | payment_button }}
            
          {%- endif -%}
        </div>
        {%- if show_low_stock_notice -%}
          <p class="product-form__low-stock caption-large" role="status">
            {%- if low_stock_inventory == 1 -%}
              Only 1 left
            {%- else -%}
              Only {{ low_stock_inventory }} left
            {%- endif -%}
          </p>
        {%- endif -%}
        {%- comment -%}
          Boots are fitted in person and cannot be bought online, so the default
          trust line ("In-store or shipping nationwide") and the shipping-rate
          note are both replaced with in-store wording. Everything else on the
          site keeps the block setting.
        {%- endcomment -%}
        {%- if in_store_only -%}
          {%- comment -%}
            Deep-links to the "Lucchese Boots Private Shopping Experience"
            service on Setmore (product id 43f4df6a-f625-400c-bc15-b05505c2206c).
            No staff id in the URL on purpose — Setmore resolves it to staff=SKIP
            so the booking isn't pinned to one person.
          {%- endcomment -%}
          <div class="product-form__trust rte">
            <p>
              <a
                href="https://moonridgecompany.setmore.com/book?step=staff&amp;products=43f4df6a-f625-400c-bc15-b05505c2206c&amp;type=service"
                rel="noopener"
              >Book a custom Lucchese Fitting Experience in our shop</a>
            </p>
          </div>
        {%- elsif block.settings.show_trust_copy and block.settings.trust_copy != blank -%}
          <div class="product-form__trust rte">
            {{ block.settings.trust_copy }}
          </div>
        {%- endif -%}
        {%- if in_store_only == false and product.selected_or_first_available_variant.requires_shipping -%}
          <p class="product-form__shipping-note caption-large">
            {%- if product.tags contains 'Ballcaps' -%}
              $6 U.S. shipping
            {%- else -%}
              Free U.S. shipping on orders over $99 &middot; $15 standard
            {%- endif -%}
          </p>
        {%- endif -%}
        {%- liquid
          assign fit_reassurance = block.settings.conversion_reassurance
          assign fit_suffix = product.template_suffix | default: '' | downcase
          assign fit_type = product.type | downcase
          assign fit_handle = product.handle | downcase
          if fit_suffix == 'boots' or fit_type == 'boots' or fit_type == 'boot care'
            assign fit_reassurance = 'Lucchese is built on a last — the surest fit is in Fayetteville. The site is a smaller menu than the floor.'
          elsif fit_type == 'apparel' or fit_handle contains 't-shirt' or fit_handle contains 'hoodie' or fit_handle contains 'sweatshirt'
            assign fit_reassurance = 'Sized as marked. If you are between sizes, go up. Questions? Email or visit us in Fayetteville.'
          elsif product.tags contains 'Ballcaps'
            assign fit_reassurance = 'Most caps are one size or snapback. Reach out if you want a closer look at the fit.'
          elsif fit_suffix == 'cowboy-hats' or fit_suffix == 'bigalli' or fit_type == 'headwear' or fit_type == 'hat care'
            assign fit_reassurance = 'Need a size? Measure two fingers above the brow, or <a href="/pages/hat-sizing">see the hat sizing guide</a>.'
          elsif fit_type == 'accessories'
            assign fit_reassurance = 'Questions on length or fit? Email us or stop by the store — we will help you pick.'
          endif
        -%}
        {%- if fit_reassurance != blank -%}
          <p class="product-form__reassurance caption-large">
            {{ fit_reassurance }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </product-form>
  {%- else -%}
    <div class="product-form">
      <div class="product-form__buttons form">
        <button
          type="submit"
          name="add"
          class="product-form__submit button button--full-width button--primary"
          disabled
        >
          {{ 'products.product.sold_out' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}
</div>
